ήσεις ξεκινούν πιο δεξιά."}},"en":{"stringUnit":{"state":"translated","value":"All rows use the same clock. Later departures start farther right."}},"es":{"stringUnit":{"state":"translated","value":"Todas las filas usan el mismo reloj. Las salidas más tardías empiezan más a la derecha."}},"fr":{"stringUnit":{"state":"translated","value":"Toutes les lignes utilisent la même échelle de temps. Les départs plus tardifs commencent plus à droite."}},"hu":{"stringUnit":{"state":"translated","value":"Minden sor ugyanazt az időtengelyt használja. A későbbi indulások jobbrább kezdődnek."}},"it":{"stringUnit":{"state":"translated","value":"Tutte le righe usano la stessa scala oraria. Le partenze più tardi iniziano più a destra."}},"nl":{"stringUnit":{"state":"translated","value":"Alle rijen gebruiken dezelfde tijdas. Latere vertrekken beginnen verder naar rechts."}},"pl":{"stringUnit":{"state":"translated","value":"Wszystkie wiersze mają tę samą oś czasu. Późniejsze odjazdy zaczynają się bardziej na prawo."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Todas as linhas usam o mesmo relógio. As partidas mais tardias começam mais à direita."}},"ro":{"stringUnit":{"state":"translated","value":"Toate rândurile folosesc aceeași axă a timpului. Plecările mai târzii încep mai la dreapta."}},"sv":{"stringUnit":{"state":"translated","value":"Alla rader använder samma tidsaxel. Senare avgångar börjar längre till höger."}},"tr":{"stringUnit":{"state":"translated","value":"Tüm satırlar aynı zaman eksenini kullanır. Daha geç kalkışlar daha sağdan başlar."}},"uk":{"stringUnit":{"state":"translated","value":"Усі рядки мають спільну шкалу часу. Пізніші відправлення починаються правіше."}}}},"Allow location access in Settings to see departures near you. Trip planning works without it.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Povolte přístup k poloze v Nastavení, abyste viděli odjezdy v okolí. Plánování cest funguje i bez něj."}},"de":{"stringUnit":{"state":"translated","value":"Erlaube den Standortzugriff in den Einstellungen, um Abfahrten in deiner Nähe zu sehen. Routen kannst du auch ohne Standort planen."}},"el":{"stringUnit":{"state":"translated","value":"Επιτρέψτε την πρόσβαση στην τοποθεσία στις Ρυθμίσεις για να βλέπετε αναχωρήσεις κοντά σας. Ο σχεδιασμός διαδρομών λειτουργεί και χωρίς αυτήν."}},"en":{"stringUnit":{"state":"translated","value":"Allow location access in Settings to see departures near you. Trip planning works without it."}},"es":{"stringUnit":{"state":"translated","value":"Permite el acceso a la ubicación en Ajustes para ver salidas cercanas. Puedes planificar rutas sin ella."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez l’accès à la localisation dans Réglages pour voir les départs à proximité. La recherche d’itinéraires fonctionne sans."}},"hu":{"stringUnit":{"state":"translated","value":"Engedélyezd a helyhozzáférést a Beállításokban, hogy lásd a közeli indulásokat. Útvonaltervezés nélküle is működik."}},"it":{"stringUnit":{"state":"translated","value":"Consenti l’accesso alla posizione in Impostazioni per vedere le partenze vicine. La ricerca dei percorsi funziona anche senza."}},"nl":{"stringUnit":{"state":"translated","value":"Sta locatietoegang toe in Instellingen om vertrektijden in de buurt te zien. Reizen plannen kan ook zonder."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól na dostęp do lokalizacji w Ustawieniach, aby widzieć odjazdy w pobliżu. Planowanie trasy działa także bez tego."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Permita o acesso à localização nas Definições para ver partidas perto de si. O planeamento de viagens funciona sem localização."}},"ro":{"stringUnit":{"state":"translated","value":"Permiteți accesul la localizare în Configurări pentru a vedea plecările din apropiere. Planificarea călătoriilor funcționează și fără."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt platsåtkomst i Inställningar för att se avgångar nära dig. Reseplaneringen fungerar utan."}},"tr":{"stringUnit":{"state":"translated","value":"Yakındaki kalkışları görmek için Ayarlar'da konum erişimine izin verin. Rota planlama konum olmadan da çalışır."}},"uk":{"stringUnit":{"state":"translated","value":"Дозвольте доступ до геопозиції в Налаштуваннях, щоб бачити відправлення поруч. Планувати маршрути можна й без цього."}}}},"Allow location access to see the lines around you, or search for a station.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Povol přístup k poloze, abys viděl linky v okolí, nebo vyhledej zastávku."}},"de":{"stringUnit":{"state":"translated","value":"Erlaube den Standortzugriff, um die Linien in deiner Nähe zu sehen, oder suche nach einer Haltestelle."}},"el":{"stringUnit":{"state":"translated","value":"Επίτρεψε την πρόσβαση στην τοποθεσία για να δεις τις γραμμές γύρω σου ή αναζήτησε μια στάση."}},"en":{"stringUnit":{"state":"translated","value":"Allow location access to see the lines around you, or search for a station."}},"es":{"stringUnit":{"state":"translated","value":"Permite el acceso a la ubicación para ver las líneas cercanas o busca una parada."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez la localisation pour voir les lignes autour de vous, ou cherchez un arrêt."}},"hu":{"stringUnit":{"state":"translated","value":"Engedélyezd a helyhozzáférést a közeli vonalakhoz, vagy keress egy megállót."}},"it":{"stringUnit":{"state":"translated","value":"Consenti l'accesso alla posizione per vedere le linee vicine, oppure cerca una fermata."}},"nl":{"stringUnit":{"state":"translated","value":"Sta locatietoegang toe om de lijnen om je heen te zien, of zoek een halte."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól na dostęp do lokalizacji, aby zobaczyć linie w pobliżu, albo wyszukaj przystanek."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Permita o acesso à localização para ver as linhas à sua volta ou procure uma paragem."}},"ro":{"stringUnit":{"state":"translated","value":"Permite accesul la locație pentru a vedea liniile din jur sau caută o stație."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt platsåtkomst för att se linjerna omkring dig, eller sök efter en hållplats."}},"tr":{"stringUnit":{"state":"translated","value":"Çevrendeki hatları görmek için konum erişimine izin ver veya bir durak ara."}},"uk":{"stringUnit":{"state":"translated","value":"Дозвольте доступ до геопозиції, щоб бачити лінії поруч, або знайдіть зупинку."}}}},"Allow notifications for Publit in Settings.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Povolte oznámení pro Publit v Nastavení."}},"de":{"stringUnit":{"state":"translated","value":"Erlaube Mitteilungen für Publit in den Einstellungen."}},"el":{"stringUnit":{"state":"translated","value":"Επιτρέψτε τις ειδοποιήσεις για το Publit στις Ρυθμίσεις."}},"en":{"stringUnit":{"state":"translated","value":"Allow notifications for Publit in Settings."}},"es":{"stringUnit":{"state":"translated","value":"Permite las notificaciones de Publit en Ajustes."}},"fr":{"stringUnit":{"state":"translated","value":"Autorisez les notifications pour Publit dans Réglages."}},"hu":{"stringUnit":{"state":"translated","value":"Engedélyezd a Publit értesítéseit a Beállításokban."}},"it":{"stringUnit":{"state":"translated","value":"Consenti le notifiche per Publit in Impostazioni."}},"nl":{"stringUnit":{"state":"translated","value":"Sta meldingen voor Publit toe in Instellingen."}},"pl":{"stringUnit":{"state":"translated","value":"Zezwól na powiadomienia Publit w Ustawieniach."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Permita as notificações do Publit nas Definições."}},"ro":{"stringUnit":{"state":"translated","value":"Permiteți notificările pentru Publit în Configurări."}},"sv":{"stringUnit":{"state":"translated","value":"Tillåt notiser för Publit i Inställningar."}},"tr