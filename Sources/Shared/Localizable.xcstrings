{"state":"translated","value":"Saída do lado oeste"}},"ro":{"stringUnit":{"state":"translated","value":"Ieșire pe partea de vest"}},"sv":{"stringUnit":{"state":"translated","value":"Utgång på västra sidan"}},"tr":{"stringUnit":{"state":"translated","value":"Batı taraftan çıkın"}},"uk":{"stringUnit":{"state":"translated","value":"Вихід із західного боку"}}}},"Exit towards %@":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Výstup směr %@"}},"de":{"stringUnit":{"state":"translated","value":"Ausgang Richtung %@"}},"el":{"stringUnit":{"state":"translated","value":"Έξοδος προς %@"}},"en":{"stringUnit":{"state":"translated","value":"Exit towards %@"}},"es":{"stringUnit":{"state":"translated","value":"Salida hacia %@"}},"fr":{"stringUnit":{"state":"translated","value":"Sortie vers %@"}},"hu":{"stringUnit":{"state":"translated","value":"Kijárat: %@ felé"}},"it":{"stringUnit":{"state":"translated","value":"Uscita verso %@"}},"nl":{"stringUnit":{"state":"translated","value":"Uitgang richting %@"}},"pl":{"stringUnit":{"state":"translated","value":"Wyjście w stronę %@"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Saída para %@"}},"ro":{"stringUnit":{"state":"translated","value":"Ieșire spre %@"}},"sv":{"stringUnit":{"state":"translated","value":"Utgång mot %@"}},"tr":{"stringUnit":{"state":"translated","value":"%@ yönüne çıkın"}},"uk":{"stringUnit":{"state":"translated","value":"Вихід у бік %@"}}}},"Experimental operator fare data, not a binding quote. Product options are not necessarily the total trip price. Check eligibility and the operator's price before buying.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Experimentální tarifní data dopravce, nejde o závaznou nabídku. Možnosti nemusí odpovídat celkové ceně cesty. Před nákupem si ověřte podmínky a cenu u dopravce."}},"de":{"stringUnit":{"state":"translated","value":"Experimentelle Tarifdaten des Betreibers, kein verbindliches Angebot. Die Ticketoptionen sind nicht unbedingt der Gesamtpreis der Fahrt. Prüfe Bedingungen und Preis vor dem Kauf beim Betreiber."}},"el":{"stringUnit":{"state":"translated","value":"Πειραματικά δεδομένα ναύλων του φορέα, όχι δεσμευτική προσφορά. Οι επιλογές δεν αντιστοιχούν απαραίτητα στη συνολική τιμή της διαδρομής. Ελέγξτε όρους και τιμή στον φορέα πριν από την αγορά."}},"en":{"stringUnit":{"state":"translated","value":"Experimental operator fare data, not a binding quote. Product options are not necessarily the total trip price. Check eligibility and the operator's price before buying."}},"es":{"stringUnit":{"state":"translated","value":"Datos tarifarios experimentales del operador, no son una oferta vinculante. Las opciones no tienen por qué ser el precio total del viaje. Comprueba las condiciones y el precio con el operador antes de comprar."}},"fr":{"stringUnit":{"state":"translated","value":"Données tarifaires expérimentales de l’opérateur, sans valeur d’offre ferme. Les options proposées ne correspondent pas forcément au prix total du trajet. Vérifiez les conditions et le prix auprès de l’opérateur avant d’acheter."}},"hu":{"stringUnit":{"state":"translated","value":"A szolgáltató kísérleti díjadatai, nem kötelező érvényű ajánlat. A lehetőségek nem feltétlenül az utazás teljes árát jelentik. Vásárlás előtt ellenőrizd a feltételeket és az árat a szolgáltatónál."}},"it":{"stringUnit":{"state":"translated","value":"Dati tariffari sperimentali dell’operatore, non un’offerta vincolante. Le opzioni non corrispondono necessariamente al prezzo totale del viaggio. Verifica condizioni e prezzo presso l’operatore prima dell’acquisto."}},"nl":{"stringUnit":{"state":"translated","value":"Experimentele tariefgegevens van de vervoerder, geen bindende prijsopgave. De opties zijn niet per se de totaalprijs van de reis. Controleer voorwaarden en prijs bij de vervoerder voordat je koopt."}},"pl":{"stringUnit":{"state":"translated","value":"Eksperymentalne dane taryfowe przewoźnika, nie stanowią wiążącej oferty. Opcje biletów nie muszą oznaczać łącznej ceny podróży. Przed zakupem sprawdź warunki i cenę u przewoźnika."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Dados tarifários experimentais do operador, sem valor de proposta vinculativa. As opções não correspondem necessariamente ao preço total da viagem. Confirme as condições e o preço junto do operador antes de comprar."}},"ro":{"stringUnit":{"state":"translated","value":"Date tarifare experimentale de la operator, nu o ofertă fermă. Opțiunile nu reprezintă neapărat prețul total al călătoriei. Verificați condițiile și prețul la operator înainte de cumpărare."}},"sv":{"stringUnit":{"state":"translated","value":"Experimentella prisuppgifter från operatören, inget bindande erbjudande. Alternativen är inte nödvändigtvis hela resans pris. Kontrollera villkor och pris hos operatören innan du köper."}},"tr":{"stringUnit":{"state":"translated","value":"İşletmeciden alınan deneysel ücret verileri, bağlayıcı bir teklif değildir. Seçenekler yolculuğun toplam fiyatı olmayabilir. Satın almadan önce koşulları ve fiyatı işletmeciden kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Експериментальні тарифні дані перевізника, не обов’язкова пропозиція. Варіанти не обов’язково відповідають повній вартості поїздки. Перед купівлею перевірте умови й ціну в перевізника."}}}},"Expired":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Platnost vypršela"}},"de":{"stringUnit":{"state":"translated","value":"Abgelaufen"}},"el":{"stringUnit":{"state":"translated","value":"Έληξε"}},"en":{"stringUnit":{"state":"translated","value":"Expired"}},"es":{"stringUnit":{"state":"translated","value":"Caducado"}},"fr":{"stringUnit":{"state":"translated","value":"Expiré"}},"hu":{"stringUnit":{"state":"translated","value":"Lejárt"}},"it":{"stringUnit":{"state":"translated","value":"Scaduto"}},"nl":{"stringUnit":{"state":"translated","value":"Verlopen"}},"pl":{"stringUnit":{"state":"translated","value":"Wygasł"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Expirado"}},"ro":{"stringUnit":{"state":"translated","value":"Expirat"}},"sv":{"stringUnit":{"state":"translated","value":"Har gått ut"}},"tr":{"stringUnit":{"state":"translated","value":"Süresi doldu"}},"uk":{"stringUnit":{"state":"translated","value":"Термін дії минув"}}}},"Expired on %@":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Platnost skončila %@"}},"de":{"stringUnit":{"state":"translated","value":"Abgelaufen am %@"}},"el":{"stringUnit":{"state":"translated","value":"Έληξε στις %@"}},"en":{"stringUnit":{"state":"translated","value":"Expired on %@"}},"es":{"stringUnit":{"state":"translated","value":"Caducó el %@"}},"fr":{"stringUnit":{"state":"translated","value":"Expiré le %@"}},"hu":{"stringUnit":{"state":"translated","value":"Lejárt: %@"}},"it":{"stringUnit":{"state":"translated","value":"Scaduto il %@"}},"nl":{"stringUnit":{"state":"translated","value":"Verlopen op %@"}},"pl":{"stringUnit":{"state":"translated","value":"Wygasł %@"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Expirou a %@"}},"ro":{"stringUnit":{"state":"translated","value":"A expirat pe %@"}},"sv":{"stringUnit":{"state":"translated","value":"Gick ut %@"}},"tr":{"stringUnit":{"state":"translated","value":"%@ tarihinde süresi doldu"}},"uk":{"stringUnit":{"state":"translated","value":"Термін дії минув %@"}}}},"Expired tickets move here a day after they end. They stay on this iPhone until you delete them.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Propadlé jízdenky se sem přesunou den po skončení platnosti. Zůstanou v tomto iPhonu, dokud je nesmažete."}},"de":{"stringUnit":{"state":"translated","value":"Abgelaufene Tickets landen einen Tag nach Ende ihrer Gültigkeit hier. Sie bleiben auf diesem iPhone, bis du sie löschst."}},"el":{"stringUnit":{"state":"translated","value":"Τα ληγμένα εισιτήρια μεταφέρονται εδώ μία ημέρα μετά τη λήξη τους. Μένουν σε αυτό το iPhone μέχρι να τα διαγράψεις."}},"en":{"stringUnit":{"state":"translated","value":"Expired tickets move here a day after they end. They stay on this iPhone until you delete them."}},"es":{"stringUnit":{"state":"translated","value":"Los billetes caducados pasan aquí un día después de terminar su validez. Se quedan en este iPhone hasta que los elimines."}},"fr":{"stringUnit":{"state":"translated","value":"Les billets expirés arrivent ici un jour après la fin de leur validité. Ils restent sur cet iPhone jusqu'à ce que vous les supprimiez."}},"hu":{"stringUnit":{"state":"translated","value":"A lejárt jegyek egy nappal az érvényesség vége után kerülnek ide. Ezen az iPhone-on maradnak, amíg nem törlöd őket."}},"it":{"stringUnit":{"state":"translated","value":"I biglietti scaduti finiscono qui un giorno dopo la fine della validità. Restano su questo iPhone finché non li elimini."}},"nl":{"stringUnit":{"state":"translated","value":"Verlopen tickets komen hier een dag nadat ze aflopen. Ze blijven op deze iPhone tot je ze verwijdert."}},"pl":{"stringUnit":{"state":"translated","value":"Wygasłe bilety trafiają tutaj dzień po końcu ważności. Zostają na tym iPhonie, dopóki ich nie usuniesz."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Os bilhetes expirados passam para aqui um dia depois de terminar a validade. Ficam neste iPhone até os apagar."}},"ro":{"stringUnit":{"state":"translated","value":"Biletele expirate ajung aici la o zi după ce li se termină valabilitatea. Rămân pe acest iPhone până le ștergi."}},"sv":{"stringUnit":{"state":"translated","value":"Utgångna biljetter hamnar här en dag efter att de slutat gälla. De ligger kvar på den här iPhonen tills du raderar dem."}},"tr":{"stringUnit":{"state":"translated","value":"Süresi dolan biletler, geçerlilikleri bittikten bir gün sonra buraya taşınır. Sen silene kadar bu iPhone'da kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Прострочені квитки переміщуються сюди через день після завершення дії. Вони залишаються на цьому iPhone, доки ви їх не видалите."}}}},"Expires":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Platnost do"}},"de":{"stringUnit":{"state":"translated","value":"Läuft ab"}},"el":{"stringUnit":{"state":"translated","value":"Λήγει"}},"en":{"stringUnit":{"state":"translated","value":"Expires"}},"es":{"stringUnit":{"state":"translated","value":"Caduca"}},"fr":{"stringUnit":{"state":"translated","value":"Expire le"}},"hu":{"stringUnit":{"state":"translated","value":"Lejár"}},"it":{"stringUnit":{"state":"translated","value":"Scade"}},"nl":{"stringUnit":{"state":"translated","value":"Verloopt"}},"pl":{"stringUnit":{"state":"translated","value":"Wygasa"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Expira"}},"ro":{"stringUnit":{"state":"translated","value":"Expiră"}},"sv":{"stringUnit":{"state":"translated","value":"Går ut"}},"tr":{"stringUnit":{"state":"translated","value":"Bitiş"}},"uk":{"stringUnit":{"state":"translated","value":"Діє до"}}}},"Failed requests":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Neúspěšné požadavky"}},"de":{"stringUnit":{"state":"translated","value":"Fehlgeschlagene Anfragen"}},"el":{"stringUnit":{"state":"translated","value":"Αποτυχημένα αιτήματα"}},"en":{"stringUnit":{"state":"translated","value":"Failed requests"}},"es":{"stringUnit":{"state":"translated","value":"Solicitudes fallidas"}},"fr":{"stringUnit":{"state":"translated","value":"Requêtes échouées"}},"hu":{"stringUnit":{"state":"translated","value":"Sikertelen kérések"}},"it":{"stringUnit":{"state":"translated","value":"Richieste non riuscite"}},"nl":{"stringUnit":{"state":"translated","value":"Mislukte verzoeken"}},"pl":{"stringUnit":{"state":"translated","value":"Nieudane zapytania"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Pedidos falhados"}},"ro":