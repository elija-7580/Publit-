u."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Code kann nicht zu Apple Wallet hinzugefügt werden. Zeig ihn stattdessen in Publit."}},"el":{"stringUnit":{"state":"translated","value":"Αυτός ο κωδικός δεν μπορεί να προστεθεί στο Apple Wallet. Δείξ’ τον στο Publit."}},"en":{"stringUnit":{"state":"translated","value":"This code cannot be added to Apple Wallet. Show it in Publit instead."}},"es":{"stringUnit":{"state":"translated","value":"Este código no se puede añadir a Apple Wallet. Muéstralo en Publit."}},"fr":{"stringUnit":{"state":"translated","value":"Ce code ne peut pas être ajouté à Apple Wallet. Montre-le plutôt dans Publit."}},"hu":{"stringUnit":{"state":"translated","value":"Ez a kód nem adható hozzá az Apple Wallethez. Mutasd a Publitban."}},"it":{"stringUnit":{"state":"translated","value":"Questo codice non può essere aggiunto ad Apple Wallet. Mostralo in Publit."}},"nl":{"stringUnit":{"state":"translated","value":"Deze code kan niet aan Apple Wallet worden toegevoegd. Toon hem in Publit."}},"pl":{"stringUnit":{"state":"translated","value":"Tego kodu nie można dodać do Apple Wallet. Pokaż go w Publit."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Este código não pode ser adicionado ao Apple Wallet. Mostra-o no Publit."}},"ro":{"stringUnit":{"state":"translated","value":"Acest cod nu poate fi adăugat în Apple Wallet. Arată-l în Publit."}},"sv":{"stringUnit":{"state":"translated","value":"Koden kan inte läggas till i Apple Wallet. Visa den i Publit i stället."}},"tr":{"stringUnit":{"state":"translated","value":"Bu kod Apple Wallet’a eklenemez. Bunun yerine Publit’te göster."}},"uk":{"stringUnit":{"state":"translated","value":"Цей код не можна додати до Apple Wallet. Покажи його в Publit."}}}},"This code is shown exactly as on the original ticket.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Tento kód se zobrazí přesně jako na původní jízdence."}},"de":{"stringUnit":{"state":"translated","value":"Dieser Code wird genau so angezeigt wie auf dem Originalticket."}},"el":{"stringUnit":{"state":"translated","value":"Αυτός ο κωδικός εμφανίζεται ακριβώς όπως στο αρχικό εισιτήριο."}},"en":{"stringUnit":{"state":"translated","value":"This code is shown exactly as on the original ticket."}},"es":{"stringUnit":{"state":"translated","value":"Este código se muestra exactamente como en el billete original."}},"fr":{"stringUnit":{"state":"translated","value":"Ce code s’affiche exactement comme sur le billet d’origine."}},"hu":{"stringUnit":{"state":"translated","value":"Ez a kód pontosan úgy jelenik meg, mint az eredeti jegyen."}},"it":{"stringUnit":{"state":"translated","value":"Questo codice viene mostrato esattamente come sul biglietto originale."}},"nl":{"stringUnit":{"state":"translated","value":"Deze code wordt precies zo getoond als op het originele ticket."}},"pl":{"stringUnit":{"state":"translated","value":"Ten kod jest wyświetlany dokładnie tak jak na oryginalnym bilecie."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Este código é mostrado exatamente como no bilhete original."}},"ro":{"stringUnit":{"state":"translated","value":"Acest cod este afișat exact ca pe biletul original."}},"sv":{"stringUnit":{"state":"translated","value":"Koden visas exakt som på originalbiljetten."}},"tr":{"stringUnit":{"state":"translated","value":"Bu kod, orijinal bilette olduğu gibi gösterilir."}},"uk":{"stringUnit":{"state":"translated","value":"Цей код показано точно так, як на оригінальному квитку."}}}},"This file could not be read.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Soubor se nepodařilo přečíst."}},"de":{"stringUnit":{"state":"translated","value":"Diese Datei konnte nicht gelesen werden."}},"el":{"stringUnit":{"state":"translated","value":"Δεν ήταν δυνατή η ανάγνωση του αρχείου."}},"en":{"stringUnit":{"state":"translated","value":"This file could not be read."}},"es":{"stringUnit":{"state":"translated","value":"No se pudo leer este archivo."}},"fr":{"stringUnit":{"state":"translated","value":"Ce fichier n’a pas pu être lu."}},"hu":{"stringUnit":{"state":"translated","value":"Nem sikerült beolvasni a fájlt."}},"it":{"stringUnit":{"state":"translated","value":"Impossibile leggere questo file."}},"nl":{"stringUnit":{"state":"translated","value":"Dit bestand kon niet worden gelezen."}},"pl":{"stringUnit":{"state":"translated","value":"Nie udało się odczytać pliku."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Não foi possível ler este ficheiro."}},"ro":{"stringUnit":{"state":"translated","value":"Fișierul nu a putut fi citit."}},"sv":{"stringUnit":{"state":"translated","value":"Filen kunde inte läsas."}},"tr":{"stringUnit":{"state":"translated","value":"Bu dosya okunamadı."}},"uk":{"stringUnit":{"state":"translated","value":"Не вдалося прочитати файл."}}}},"This file is too large for a ticket.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Soubor je na jízdenku příliš velký."}},"de":{"stringUnit":{"state":"translated","value":"Diese Datei ist zu groß für ein Ticket."}},"el":{"stringUnit":{"state":"translated","value":"Το αρχείο είναι πολύ μεγάλο για εισιτήριο."}},"en":{"stringUnit":{"state":"translated","value":"This file is too large for a ticket."}},"es":{"stringUnit":{"state":"translated","value":"Este archivo es demasiado grande para un billete."}},"fr":{"stringUnit":{"state":"translated","value":"Ce fichier est trop volumineux pour un billet."}},"hu":{"stringUnit":{"state":"translated","value":"A fájl túl nagy egy jegyhez."}},"it":{"stringUnit":{"state":"translated","value":"Questo file è troppo grande per un biglietto."}},"nl":{"stringUnit":{"state":"translated","value":"Dit bestand is te groot voor een ticket."}},"pl":{"stringUnit":{"state":"translated","value":"Ten plik jest za duży jak na bilet."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Este ficheiro é demasiado grande para um bilhete."}},"ro":{"stringUnit":{"state":"translated","value":"Fișierul este prea mare pentru un bilet."}},"sv":{"stringUnit":{"state":"translated","value":"Filen är för stor för en biljett."}},"tr":{"stringUnit":{"state":"translated","value":"Bu dosya bir bilet için çok büyük."}},"uk":{"stringUnit":{"state":"translated","value":"Файл завеликий для квитка."}}}},"This is a comparison, not live progress. Check the departure times, line names and change warnings.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Jde o srovnání, ne o průběh v reálném čase. Zkontrolujte časy odjezdů, linky a upozornění na přestupy."}},"de":{"stringUnit":{"state":"translated","value":"Das ist ein Vergleich, kein Live-Fortschritt. Achte auf Abfahrtszeiten, Linien und Umstiegshinweise."}},"el":{"stringUnit":{"state":"translated","value":"Είναι σύγκριση, όχι ζωντανή πρόοδος. Ελέγξτε ώρες αναχώρησης, γραμμές και προειδοποιήσεις μετεπιβίβασης."}},"en":{"stringUnit":{"state":"translated","value":"This is a comparison, not live progress. Check the departure times, line names and change warnings."}},"es":{"stringUnit":{"state":"translated","value":"Es una comparación, no el progreso en directo. Revisa las horas de salida, las líneas y los avisos de transbordo."}},"fr":{"stringUnit":{"state":"translated","value":"Il s’agit d’une comparaison, pas d’une progression en direct. Vérifiez les horaires, les lignes et les alertes de correspondance."}},"hu":{"stringUnit":{"state":"translated","value":"Ez összehasonlítás, nem élő haladás. Ellenőrizd az indulási időket, a vonalakat és az átszállási figyelmeztetéseket."}},"it":{"stringUnit":{"state":"translated","value":"È un confronto, non l’avanzamento in tempo reale. Controlla orari di partenza, linee e avvisi sui cambi."}},"nl":{"stringUnit":{"state":"translated","value":"Dit is een vergelijking, geen live voortgang. Let op vertrektijden, lijnen en overstapwaarschuwingen."}},"pl":{"stringUnit":{"state":"translated","value":"To porównanie, a nie postęp na żywo. Sprawdź godziny odjazdu, linie i ostrzeżenia o przesiadkach."}},"pt-PT":{"stringUnit":{"state":"translated","value":"É uma comparação, não o progresso em tempo real. Verifique as horas de partida, as linhas e os avisos de transbordo."}},"ro":{"stringUnit":{"state":"translated","value":"Este o comparație, nu progresul în timp real. Verifică orele de plecare, liniile și avertizările de transfer."}},"sv":{"stringUnit":{"state":"translated","value":"Det här är en jämförelse, inte liveförlopp. Kontrollera avgångstider, linjer och bytesvarningar."}},"tr":{"stringUnit":{"state":"translated","value":"Bu bir karşılaştırmadır, canlı ilerleme değildir. Kalkış saatlerini, hatları ve aktarma uyarılarını kontrol edin."}},"uk":{"stringUnit":{"state":"translated","value":"Це порівняння, а не поступ у реальному часі. Перевіряйте час відправлення, лінії та попередження про пересадки."}}}},"This is not a valid link.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Toto není platný odkaz."}},"de":{"stringUnit":{"state":"translated","value":"Das ist kein gültiger Link."}},"el":{"stringUnit":{"state":"translated","value":"Αυτός δεν είναι έγκυρος σύνδεσμος."}},"en":{"stringUnit":{"state":"translated","value":"This is not a valid link."}},"es":{"stringUnit":{"state":"translated","value":"Este enlace no es válido."}},"fr":{"stringUnit":{"state":"translated","value":"Ce lien n’est pas valide."}},"hu":{"stringUnit":{"state":"translated","value":"Ez nem érvényes link."}},"it":{"stringUnit":{"state":"translated","value":"Questo link non è valido."}},"nl":{"stringUnit":{"state":"translated","value":"Dit is geen geldige link."}},"pl":{"stringUnit":{"state":"translated","value":"To nie jest prawidłowy link."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Esta ligação não é válida."}},"ro":{"stringUnit":{"state":"translated","value":"Acesta nu este un link valid."}},"sv":{"stringUnit":{"state":"tr