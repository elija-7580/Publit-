,"value":"La fecha de fin no puede ser anterior a la de inicio."}},"fr":{"stringUnit":{"state":"translated","value":"La date de fin ne doit pas précéder la date de début."}},"hu":{"stringUnit":{"state":"translated","value":"A záródátum nem lehet korábbi a kezdődátumnál."}},"it":{"stringUnit":{"state":"translated","value":"La data di fine non può precedere quella di inizio."}},"nl":{"stringUnit":{"state":"translated","value":"De einddatum mag niet vóór de begindatum liggen."}},"pl":{"stringUnit":{"state":"translated","value":"Data końcowa nie może być wcześniejsza niż początkowa."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A data de fim não pode ser anterior à data de início."}},"ro":{"stringUnit":{"state":"translated","value":"Data de sfârșit nu poate fi înaintea datei de început."}},"sv":{"stringUnit":{"state":"translated","value":"Slutdatumet får inte vara före startdatumet."}},"tr":{"stringUnit":{"state":"translated","value":"Bitiş tarihi başlangıç tarihinden önce olamaz."}},"uk":{"stringUnit":{"state":"translated","value":"Дата закінчення не може бути раніше дати початку."}}}},"The nearest departures are %@ away, about %lld min on foot.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"needs_review","value":"Nejbližší odjezdy jsou %@ daleko, asi %lld min pěšky."}},"de":{"stringUnit":{"state":"needs_review","value":"Die nächsten Abfahrten sind %@ entfernt, etwa %lld Min. zu Fuß."}},"el":{"stringUnit":{"state":"needs_review","value":"Οι πλησιέστερες αναχωρήσεις απέχουν %@, περίπου %lld λεπτά με τα πόδια."}},"en":{"stringUnit":{"state":"translated","value":"The nearest departures are %@ away, about %lld min on foot."}},"es":{"stringUnit":{"state":"needs_review","value":"Las salidas más cercanas están a %@, unos %lld min a pie."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les départs les plus proches sont à %@, environ %lld min à pied."}},"hu":{"stringUnit":{"state":"needs_review","value":"A legközelebbi indulások %@ tá