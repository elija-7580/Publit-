nnern zu lassen."}},"el":{"stringUnit":{"state":"translated","value":"Αποθηκεύστε μια διαδρομή για να τη βλέπετε εδώ, να την προσθέσετε στο ημερολόγιο και να λάβετε υπενθύμιση πότε να ξεκινήσετε."}},"en":{"stringUnit":{"state":"translated","value":"Save a route to see it here, add it to your calendar and get a reminder when to leave."}},"es":{"stringUnit":{"state":"translated","value":"Guarda una ruta para verla aquí, añadirla al calendario y recibir un aviso de cuándo salir."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrez un itinéraire pour le retrouver ici, l’ajouter au calendrier et recevoir un rappel de départ."}},"hu":{"stringUnit":{"state":"translated","value":"Ments el egy útvonalat, hogy itt lásd, a naptáradba tedd, és emlékeztetőt kapj, mikor indulj."}},"it":{"stringUnit":{"state":"translated","value":"Salva un percorso per ritrovarlo qui, aggiungerlo al calendario e ricevere un promemoria per partire."}},"nl":{"stringUnit":{"state":"translated","value":"Bewaar een route om hem hier te zien, in je agenda te zetten en een herinnering te krijgen wanneer je moet vertrekken."}},"pl":{"stringUnit":{"state":"translated","value":"Zapisz trasę, aby widzieć ją tutaj, dodać do kalendarza i dostać przypomnienie o wyjściu."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Guarde uma rota para a ver aqui, adicioná-la ao calendário e receber um lembrete de quando sair."}},"ro":{"stringUnit":{"state":"translated","value":"Salvați o rută ca s-o vedeți aici, s-o adăugați în calendar și să primiți un memento când să plecați."}},"sv":{"stringUnit":{"state":"translated","value":"Spara en resväg för att se den här, lägga till den i kalendern och få en påminnelse om när du ska gå."}},"tr":{"stringUnit":{"state":"translated","value":"Bir rotayı burada görmek, takviminize eklemek ve ne zaman çıkacağınıza dair hatırlatıcı almak için kaydedin."}},"uk":{"stringUnit":{"state":"translated","value":"Збережіть маршрут, щоб бачити його тут, додати в календар і отримати нагадування, коли вирушати."}}}},"Save line":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Uložit linku"}},"de":{"stringUnit":{"state":"translated","value":"Linie speichern"}},"el":{"stringUnit":{"state":"translated","value":"Αποθήκευση γραμμής"}},"en":{"stringUnit":{"state":"translated","value":"Save line"}},"es":{"stringUnit":{"state":"translated","value":"Guardar línea"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrer la ligne"}},"hu":{"stringUnit":{"state":"translated","value":"Vonal mentése"}},"it":{"stringUnit":{"state":"translated","value":"Salva linea"}},"nl":{"stringUnit":{"state":"translated","value":"Lijn bewaren"}},"pl":{"stringUnit":{"state":"translated","value":"Zapisz linię"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Guardar linha"}},"ro":{"stringUnit":{"state":"translated","value":"Salvați linia"}},"sv":{"stringUnit":{"state":"translated","value":"Spara linje"}},"tr":{"stringUnit":{"state":"translated","value":"Hattı kaydet"}},"uk":{"stringUnit":{"state":"translated","value":"Зберегти лінію"}}}},"Save stops from their departure board, lines from a trip, or add places with +.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Ukládejte zastávky z jejich odjezdové tabule, linky z cesty, nebo přidejte místa tlačítkem +."}},"de":{"stringUnit":{"state":"translated","value":"Speichere Haltestellen über ihre Abfahrtstafel und Linien über eine Fahrt. Orte fügst du mit + hinzu."}},"el":{"stringUnit":{"state":"translated","value":"Αποθηκεύστε στάσεις από τον πίνακα αναχωρήσεων, γραμμές από μια διαδρομή, ή προσθέστε τοποθεσίες με +."}},"en":{"stringUnit":{"state":"translated","value":"Save stops from their departure board, lines from a trip, or add places with +."}},"es":{"stringUnit":{"state":"translated","value":"Guarda paradas desde su panel de salidas, líneas desde un viaje, o añade lugares con +."}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrez des arrêts depuis leur tableau des départs, des lignes depuis un trajet, ou ajoutez des lieux avec +."}},"hu":{"stringUnit":{"state":"translated","value":"A megállókat az indulási táblájukról, a vonalakat egy utazásból mentheted, helyeket pedig a + gombbal adhatsz hozzá."}},"it":{"stringUnit":{"state":"translated","value":"Salva le fermate dal loro tabellone, le linee da un viaggio, oppure aggiungi luoghi con +."}},"nl":{"stringUnit":{"state":"translated","value":"Bewaar haltes via hun vertrekbord, lijnen via een reis, of voeg plaatsen toe met +."}},"pl":{"stringUnit":{"state":"translated","value":"Zapisuj przystanki z tablicy odjazdów, linie z podróży albo dodawaj miejsca przyciskiem +."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Guarde paragens a partir do quadro de partidas, linhas a partir de uma viagem, ou adicione locais com +."}},"ro":{"stringUnit":{"state":"translated","value":"Salvați stații din tabela de plecări, linii dintr-o călătorie sau adăugați locuri cu +."}},"sv":{"stringUnit":{"state":"translated","value":"Spara hållplatser från deras avgångstavla, linjer från en resa, eller lägg till platser med +."}},"tr":{"stringUnit":{"state":"translated","value":"Durakları kalkış tablolarından, hatları bir yolculuktan kaydedin ya da + ile yer ekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Зберігайте зупинки з табло відправлень, лінії з поїздки або додавайте місця кнопкою +."}}}},"Save trip":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Uložit cestu"}},"de":{"stringUnit":{"state":"translated","value":"Fahrt speichern"}},"el":{"stringUnit":{"state":"translated","value":"Αποθήκευση διαδρομής"}},"en":{"stringUnit":{"state":"translated","value":"Save trip"}},"es":{"stringUnit":{"state":"translated","value":"Guardar viaje"}},"fr":{"stringUnit":{"state":"translated","value":"Enregistrer le trajet"}},"hu":{"stringUnit":{"state":"translated","value":"Utazás mentése"}