":"%lld paragem"}},"other":{"stringUnit":{"state":"translated","value":"%lld paragens"}}}}},"ro":{"variations":{"plural":{"few":{"stringUnit":{"state":"translated","value":"%lld stații"}},"one":{"stringUnit":{"state":"translated","value":"%lld stație"}},"other":{"stringUnit":{"state":"translated","value":"%lld de stații"}}}}},"sv":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld hållplats"}},"other":{"stringUnit":{"state":"translated","value":"%lld hållplatser"}}}}},"tr":{"variations":{"plural":{"one":{"stringUnit":{"state":"translated","value":"%lld durak"}},"other":{"stringUnit":{"state":"translated","value":"%lld durak"}}}}},"uk":{"variations":{"plural":{"few":{"stringUnit":{"state":"translated","value":"%lld зупинки"}},"many":{"stringUnit":{"state":"translated","value":"%lld зупинок"}},"one":{"stringUnit":{"state":"translated","value":"%lld зупинка"}},"other":{"stringUnit":{"state":"translated","value":"%lld зупинки"}}}}}}},"(%lld min late)":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"(zpoždění %lld min)"}},"de":{"stringUnit":{"state":"translated","value":"(%lld Min. Verspätung)"}},"el":{"stringUnit":{"state":"translated","value":"(καθυστέρηση %lld λεπ.)"}},"en":{"stringUnit":{"state":"translated","value":"(%lld min late)"}},"es":{"stringUnit":{"state":"translated","value":"(%lld min de retraso)"}},"fr":{"stringUnit":{"state":"translated","value":"(%lld min de retard)"}},"hu":{"stringUnit":{"state":"translated","value":"(%lld perc késés)"}},"it":{"stringUnit":{"state":"translated","value":"(%lld min di ritardo)"}},"nl":{"stringUnit":{"state":"translated","value":"(%lld min vertraging)"}},"pl":{"stringUnit":{"state":"translated","value":"(%lld min opóźnienia)"}},"pt-PT":{"stringUnit":{"state":"translated","value":"(%lld min de atraso)"}},"ro":{"stringUnit":{"state":"translated","value":"(%lld min întârziere)"}},"sv":{"stringUnit":{"state":"translated","value":"(%lld min försenad)"}},"tr":{"stringUnit":{"state":"translated","value":"(%lld dk gecikme)"}},"uk":{"stringUnit":{"state":"translated","value":"(запізнення %lld хв)"}}}},"+%lld":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"+%lld"}},"de":{"stringUnit":{"state":"translated","value":"+%lld"}},"el":{"stringUnit":{"state":"translated","value":"+%lld"}},"en":{"stringUnit":{"state":"translated","value":"+%lld"}},"es":{"stringUnit":{"state":"translated","value":"+%lld"}},"fr":{"stringUnit":{"state":"translated","value":"+%lld"}},"hu":{"stringUnit":{"state":"translated","value":"+%lld"}},"it":{"stringUnit":{"state":"translated","value":"+%lld"}},"nl":{"stringUnit":{"state":"translated","value":"+%lld"}},"pl":{"stringUnit":{"state":"translated","value":"+%lld"}},"pt-PT":{"stringUnit":{"state":"translated","value":"+%lld"}},"ro":{"stringUnit":{"state":"translated","value":"+%lld"}},"sv":{"stringUnit":{"state":"translated","value":"+%lld"}},"tr":{"stringUnit":{"state":"translated","value":"+%lld"}},"uk":{"stringUnit":{"state":"translated","value":"+%lld"}}}},"+%lld min":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"+%lld min"}},"de":{"stringUnit":{"state":"translated","value":"+%lld min"}},"el":{"stringUnit":{"state":"translated","value":"+%lld λεπ."}},"en":{"stringUnit":{"state":"translated","value":"+%lld min"}},"es":{"stringUnit":{"state":"translated","value":"+%lld mín."}},"fr":{"stringUnit":{"state":"translated","value":"+%lldmin"}},"hu":{"stringUnit":{"state":"translated","value":"+%lld perc"}},"it":{"stringUnit":{"state":"translated","value":"+%lld min"}},"nl":{"stringUnit":{"state":"translated","value":"+%lld min"}},"pl":{"stringUnit":{"state":"translated","value":"+%lldmin"}},"pt-PT":{"stringUnit":{"state":"translated","value":"+%lld min"}},"ro":{"stringUnit":{"state":"translated","value":"+%lld min"}},"sv":{"stringUnit":{"state":"translated","value":"+%lld min"}},"tr":{"stringUnit":{"state":"translated","value":"+%lld dk"}},"uk":{"stringUnit":{"state":"translated","value":"+%lld хв"}}}},"1 change":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"1 přestup"}},"de":{"stringUnit":{"state":"translated","value":"1 Umstieg"}},"el":{"stringUnit":{"state":"translated","value":"1 μετεπιβίβαση"}},"en":{"stringUnit":{"state":"translated","value":"1 change"}},"es":{"stringUnit":{"state":"translated","value":"1 transbordo"}},"fr":{"stringUnit":{"state":"translated","value":"1 correspondance"}},"hu":{"stringUnit":{"state":"translated","value":"1 átszállás"}},"it":{"stringUnit":{"state":"translated","value":"1 cambio"}},"nl":{"stringUnit":{"state":"translated","value":"1 overstap"}},"pl":{"stringUnit":{"state":"translated","value":"1 przesiadka"}},"pt-PT":{"stringUnit":{"state":"translated","value":"1 transbordo"}},"ro":{"stringUnit":{"state":"translated","value":"1 schimbare"}},"sv":{"stringUnit":{"state":"translated","value":"1 byte"}},"tr":{"stringUnit":{"state":"translated","value":"1 aktarma"}},"uk":{"stringUnit":{"state":"translated","value":"1 пересадка"}}}},"1 stop":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"1 zastávka"}},"de":{"stringUnit":{"state":"translated","value":"1 Haltestelle"}},"el":{"stringUnit":{"state":"translated","value":"1 στάση"}},"en":{"stringUnit":{"state":"translated","value":"1 stop"}},"es":{"stringUnit":{"state":"translated","value":"1 parada"}},"fr":{"stringUnit":{"state":"translated","value":"1 arrêt"}},"hu":{"stringUnit":{"state":"translated","value":"1 megálló"}},"it":{"stringUnit":{"state":"translated","value":"1 fermata"}},"nl":{"stringUnit":{"state":"translated","value":"1 halte"}},"pl":{"stringUnit":{"state":"translated","value":"1 przystanek"}},"pt-PT":{"stringUnit":{"state":"translated","value":"1 paragem"}},"ro":{"stringUnit":{"state":"translated","value":"1 stație"}},"sv":{"stringUnit":{"state":"translated","value":"1 hållplats"}},"tr":{"stringUnit":{"state":"translated","value":"1 durak"}},"uk":{"stringUnit":{"state":"translated","value":"1 зупинка"}}}},"3D terrain and buildings":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Terén a budovy ve 3D"}},"de":{"stringUnit":{"state":"translated","value":"Gelände und Gebäude in 3D"}},"el":{"stringUnit":{"state":"translated","value":"Έδαφος και κτίρια σε 3D"}},"en":{"stringUnit":{"state":"translated","value":"3D terrain and buildings"}},"es":{"stringUnit":{"state":"translated","value":"Terreno y edificios en 3D"}},"fr":{"stringUnit":{"state":"translated","value":"Relief et bâtiments en 3D"}},"hu":{"stringUnit":{"state":"translated","value":"Domborzat és épületek 3D-ben"}},"it":{"stringUnit":{"state":"translated","value":"Terreno ed edifici in 3D"}},"nl":{"stringUnit":{"state":"translated","value":"Terrein en gebouwen in 3D"}},"pl":{"stringUnit":{"state":"translated","value":"Teren i budynki 3D"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Terreno e edifícios em 3D"}},"ro":{"stringUnit":{"state":"translated","value":"Relief și clădiri 3D"}},"sv":{"stringUnit":{"state":"translated","value":"Terräng och byggnader i 3D"}},"tr":{"stringUnit":{"state":"translated","value":"3B arazi ve binalar"}},"uk":{"stringUnit":{"state":"translated","value":"Рельєф і будівлі в 3D"}}}},"A copy of your ticket for quick access. Only the ticket the operator issued is valid. Inspectors may ask for it or for the operator's app.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Kopie tvé jízdenky pro rychlý přístup. Platí jen jízdenka vydaná dopravcem. Revizor si ji může vyžádat, nebo aplikaci dopravce."}},"de":{"stringUnit":{"state":"translated","value":"Eine Kopie deines Tickets für den schnellen Zugriff. Gültig ist nur das Ticket des Verkehrsunternehmens. Bei Kontrollen kann es oder die App des Unternehmens verlangt werden."}},"el":{"stringUnit":{"state":"translated","value":"Αντίγραφο του εισιτηρίου σου για γρήγορη πρόσβαση. Ισχύει μόνο το εισιτήριο που εξέδωσε ο φορέας. Στον έλεγχο μπορεί να ζητηθεί αυτό ή η εφαρμογή του φορέα."}},"en":{"stringUnit":{"state":"translated","value":"A copy of your ticket for quick access. Only the ticket the operator issued is valid. Inspectors may ask for it or for the operator's app."}},"es":{"stringUnit":{"state":"translated","value":"Una copia de tu billete para tenerlo a mano. Solo vale el billete emitido por el operador. En un control pueden pedírtelo, o la app del operador."}},"fr":{"stringUnit":{"state":"translated","value":"Une copie de ton billet pour y accéder vite. Seul le billet émis par l’opérateur est valable. Les contrôleurs peuvent le demander, ou l’app de l’opérateur."}},"hu":{"stringUnit":{"state":"translated","value":"A jegyed másolata a gyors eléréshez. Csak a szolgáltató által kiadott jegy érvényes. Ellenőrzéskor ezt vagy a szolgáltató appját kérhetik."}},"it":{"stringUnit":{"state":"translated","value":"Una copia del tuo biglietto per averlo subito a portata di mano. Vale solo il biglietto emesso dall’operatore. I controllori possono chiederlo, o l’app dell’operatore."}},"nl":{"stringUnit":{"state":"translated","value":"Een kopie van je ticket voor snelle toegang. Alleen het ticket van de vervoerder is geldig. Bij controle kan daarom of om de app van de vervoerder worden gevraagd."}},"pl":{"stringUnit":{"state":"translated","value":"Kopia biletu, by mieć go pod ręką. Ważny jest tylko bilet wydany przez przewoźnika. Kontroler może poprosić o niego lub o aplikację przewoźnika."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Uma cópia do teu bilhete para acesso rápido. Só é válido o bilhete emitido pelo operador. Na fiscalização podem pedi-lo, ou a app do operador."}},"ro":{"stringUnit":{"state":"translated","value":"O copie a biletului tău, mereu la îndemână. Valabil este doar biletul emis de operator. La control ți se poate cere acesta sau aplicația operatorului."}},"sv":{"stringUnit":{"state":"translated","value":"En kopia av din biljett för snabb åtkomst. Bara biljetten från trafikbolaget gäller. Vid kontroll kan du behöva visa den eller trafikbolagets app."}},"tr":{"stringUnit":{"state":"translated","value":"Hızlı erişim için biletinin bir kopyası. Yalnızca işletmecinin verdiği bilet geçerlidir. Kontrolde bu bilet ya da işletmecinin uygulaması istenebilir."}},"uk":{"stringUnit":{"state":"translated","value":"Копія твого квитка для швидкого доступу. Дійсний лише квиток, виданий перевізником. Контролер може попросити його або застосунок перевізника."}}}},"A copy of your ticket, made with Publit. Only the ticket the operator issued is valid; keep it with you.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Kopie tvé jízdenky vytvořená v Publitu. Platí jen jízdenka vydaná dopravcem – měj ji u sebe."}},"de":{"stringUnit":{"state":"translated","value":"Eine Kopie deines Tickets, erstellt mit Publit. Gültig ist nur das Ticket des Verkehrsunternehmens. Hab es dabei."}},"el":{"stringUnit":{"state":"translated","value":"Αντίγραφο του εισιτηρίου σου, φτιαγμένο με το Publit. Ισχύει μόνο το εισιτήριο του φορέα· να το έχεις μαζί σου."}},"en":{"stringUnit":{"state":"translated","value":"A copy of your ticket, made with Publit. Only the ticket the operator issued is valid; keep it with you."}},"es":{"stringUnit":{"state":"translated","value":"Una copia de tu billete, creada con Publit. Solo vale el billete emitido por el operador; llévalo contigo."}},"fr":{"stringUnit":{"state":"translated","value":"Une copie de ton billet, créée avec Publit. Seul le billet émis par l’opérateur est valable ; garde-le sur toi."}},"hu":{"stringUnit":{"state":"translated","value":"A jegyed másolata, a Publittal készült. Csak a szolgáltató által kiadott jegy érvényes, legyen nálad."}},"it":{"stringUnit":{"state":"translated","value":"Una copia del tuo biglietto, creata con Publit. Vale solo il biglietto emesso dall’operatore: tienilo con te."}},"nl":{"stringUnit":{"state":"translated","value":"Een kopie van je ticket, gemaakt met Publit. Alleen het ticket van de vervoerder is geldig; neem het mee."}},"pl":{"stringUnit":{"state":"translated","value":"Kopia biletu utworzona w Publit. Ważny jest tylko bilet wydany przez przewoźnika – miej go przy sobie."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Uma cópia do teu bilhete, criada com o Publit. Só é válido o bilhete emitido pelo operador; leva-o contigo."}},"ro":{"stringUnit":{"state":"translated","value":"O copie a biletului tău, creată cu Publit. Valabil este doar biletul emis de operator; ține-l la tine."}},"sv":{"stringUnit":{"state":"translated","value":"En kopia av din biljett, gjord med Publit. Bara biljetten från trafikbolaget gäller – ha den med dig."}},"tr":{"stringUnit":{"state":"translated","value":"Biletinin Publit ile oluşturulmuş kopyası. Yalnızca işletmecinin verdiği bilet geçerlidir; yanında bulundur."}},"uk":{"stringUnit":{"state":"translated","value":"Копія твого квитка, створена в Publit. Дійсний лише квиток, виданий перевізником, – май його з собою."}}}},"A screenshot of the ticket or its QR code. Inspectors usually need the live ticket in the operator's app; use the link below for that.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Snímek obrazovky jízdenky nebo jejího QR kódu. Při kontrole je obvykle potřeba aktivní jízdenka v aplikaci dopravce: otevřete ji odkazem níže."}},"de":{"stringUnit":{"state":"translated","value":"Ein Screenshot des Tickets oder QR-Codes. Für die Kontrolle brauchst du meist das aktive Ticket in der Betreiber-App. Öffne es über den Link unten."}},"el":{"stringUnit":{"state":"translated","value":"Στιγμιότυπο του εισιτηρίου ή του κωδικού QR. Στον έλεγχο συνήθως χρειάζεται το ενεργό εισιτήριο στην εφαρμογή του φορέα: ανοίξτε το από τον σύνδεσμο παρακάτω."}},"en":{"stringUnit":{"state":"translated","value":"A screenshot of the ticket or its QR code. Inspectors usually need the live ticket in the operator's app; use the link below for that."}},"es":{"stringUnit":{"state":"translated","value":"Una captura de pantalla del billete o de su código QR. En los controles suele hacer falta el billete activo en la app del operador: ábrelo con el enlace de abajo."}},"fr":{"stringUnit":{"state":"translated","value":"Une capture d’écran du billet ou de son code QR. Lors d’un contrôle, il faut souvent le billet actif dans l’app de l’opérateur : ouvrez-le avec le lien ci-dessous."}},"hu":{"stringUnit":{"state":"translated","value":"A jegy vagy a QR-kód képernyőképe. Ellenőrzéskor általában az aktív jegy kell a szolgáltató appjában: nyisd meg a lenti linkkel."}},"it":{"stringUnit":{"state":"translated","value":"Uno screenshot del biglietto o del suo codice QR. Al controllo di solito serve il biglietto attivo nell’app dell’operatore: aprilo con il link qui sotto."}},"nl":{"stringUnit":{"state":"translated","value":"Een screenshot van het ticket of de QR-code. Bij controle heb je meestal het actieve ticket in de app van de vervoerder nodig: open het via de link hieronder."}},"pl":{"stringUnit":{"state":"translated","value":"Zrzut ekranu biletu lub jego kodu QR. Przy kontroli zwykle potrzebny jest aktywny bilet w aplikacji przewoźnika: otworzysz go linkiem poniżej."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Uma captura de ecrã do bilhete ou do respetivo código QR. Na fiscalização costuma ser preciso o bilhete ativo na app do operador: abra-o pela ligação abaixo."}},"ro":{"stringUnit":{"state":"translated","value":"O captură de ecran a biletului sau a codului QR. La control este de obicei nevoie de biletul activ din aplicația operatorului: deschideți-l cu linkul de mai jos."}},"sv":{"stringUnit":{"state":"translated","value":"En skärmbild av biljetten eller dess QR-kod. Vid kontroll behövs oftast den aktiva biljetten i operatörens app: öppna den via länken nedan."}},"tr":{"stringUnit":{"state":"translated","value":"Biletin veya QR kodunun ekran görüntüsü. Kontrolde genellikle işletmecinin uygulamasındaki etkin bilet gerekir: aşağıdaki bağlantıyla açın."}},"uk":{"stringUnit":{"state":"translated","value":"Знімок екрана квитка або його QR-коду. Під час перевірки зазвичай потрібен активний квиток у застосунку перевізника: відкрийте його за посиланням нижче."}}}},"A stored screenshot may not be accepted. Use the operator's live ticket when required.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Uložený snímek nemusí být uznán. V případě potřeby použijte aktivní jízdenku dopravce."}},"de":{"stringUnit":{"state":"translated","value":"Ein Screenshot wird nicht immer akzeptiert. Verwende bei Bedarf das aktive Ticket in der Betreiber-App."}},"el":{"stringUnit":{"state":"translated","value":"Ένα αποθηκευμένο στιγμιότυπο μπορεί να μη γίνει δεκτό. Όταν χρειάζεται, δείξτε το ενεργό εισιτήριο του φορέα."}},"en":{"stringUnit":{"state":"translated","value":"A stored screenshot may not be accepted. Use the operator's live ticket when required."}},"es":{"stringUnit":{"state":"translated","value":"Puede que no acepten una captura guardada. Si hace falta, usa el billete activo del operador."}},"fr":{"stringUnit":{"state":"translated","value":"Une capture d’écran n’est pas toujours acceptée. Utilisez le billet actif de l’opérateur si nécessaire."}},"hu":{"stringUnit":{"state":"translated","value":"Előfordulhat, hogy a mentett képernyőképet nem fogadják el. Ha kell, használd a szolgáltató aktív jegyét."}},"it":{"stringUnit":{"state":"translated","value":"Uno screenshot salvato potrebbe non essere accettato. Se serve, usa il biglietto attivo dell’operatore."}},"nl":{"stringUnit":{"state":"translated","value":"Een opgeslagen screenshot wordt mogelijk niet geaccepteerd. Gebruik zo nodig het actieve ticket van de vervoerder."}},"pl":{"stringUnit":{"state":"translated","value":"Zapisany zrzut ekranu może nie zostać uznany. W razie potrzeby pokaż aktywny bilet przewoźnika."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Uma captura de ecrã guardada pode não ser aceite. Se necessário, use o bilhete ativo do operador."}},"ro":{"stringUnit":{"state":"translated","value":"O captură salvată poate să nu fie acceptată. Folosiți biletul activ al operatorului când e nevoie."}},"sv":{"stringUnit":{"state":"translated","value":"En sparad skärmbild godtas kanske inte. Använd operatörens aktiva biljett när det krävs."}},"tr":{"stringUnit":{"state":"translated","value":"Kayıtlı bir ekran görüntüsü kabul edilmeyebilir. Gerektiğinde işletmecinin etkin biletini kullanın."}},"uk":{"stringUnit":{"state":"translated","value":"Збережений знімок можуть не прийняти. За потреби покажіть активний квиток перевізника."}}}},"A web address (many ticket apps open from their website link) or the app's own link, e.g. appname://.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Webová adresa, která otevře vaši aplikaci s jízdenkami, nebo vlastní odkaz aplikace, např. appname://."}},"de":{"stringUnit":{"state":"translated","value":"Eine Webadresse, die die Ticket-App öffnet, oder ein direkter App-Link, z. B. appname://."}},"el":{"stringUnit":{"state":"translated","value":"Μια διεύθυνση web που ανοίγει την εφαρμογή εισιτηρίων σας ή ο σύνδεσμος της ίδιας της εφαρμογής, π.χ. appname://."}},"en":{"stringUnit":{"state":"translated","value":"A web address that opens your ticket app, or the app's own link, e.g. appname://."}},"es":{"stringUnit":{"state":"translated","value":"Una dirección web que abre tu app de billetes, o el enlace propio de la app, p. ej. appname://."}},"fr":{"stringUnit":{"state":"translated","value":"Une adresse web qui ouvre votre app de billets, ou le lien propre à l’app, par ex. appname://."}},"hu":{"stringUnit":{"state":"translated","value":"Webcím, amely megnyitja a jegyappodat, vagy az app saját linkje, pl. appname://."}},"it":{"stringUnit":{"state":"translated","value":"Un indirizzo web che apre la tua app dei biglietti, oppure il link diretto dell’app, ad es. appname://."}},"nl":{"stringUnit":{"state":"translated","value":"Een webadres dat je ticket-app opent, of de eigen link van de app, bijv. appname://."}},"pl":{"stringUnit":{"state":"translated","value":"Adres strony, który otwiera Twoją aplikację biletową, albo własny link aplikacji, np. appname://."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Um endereço web que abre a sua app de bilhetes, ou a ligação própria da app, p. ex. appname://."}},"ro":{"stringUnit":{"state":"translated","value":"O adresă web care vă deschide aplicația de bilete sau linkul propriu al aplicației, de ex. appname://."}},"sv":{"stringUnit":{"state":"translated","value":"En webbadress som öppnar din biljettapp, eller appens egen länk, t.ex. appname://."}},"tr":{"stringUnit":{"state":"translated","value":"Bilet uygulamanızı açan bir web adresi ya da uygulamanın kendi bağlantısı, ör. appname://."}},"uk":{"stringUnit":{"state":"translated","value":"Вебадреса, яка відкриває ваш застосунок із квитками, або власне посилання застосунку, напр. appname://."}}}},"About":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"O aplikaci"}},"de":{"stringUnit":{"state":"translated","value":"Über Publit"}},"el":{"stringUnit":{"state":"translated","value":"Πληροφορίες"}},"en":{"stringUnit":{"state":"translated","value":"About"}},"es":{"stringUnit":{"state":"translated","value":"Acerca de"}},"fr":{"stringUnit":{"state":"translated","value":"À propos"}},"hu":{"stringUnit":{"state":"translated","value":"Névjegy"}},"it":{"stringUnit":{"state":"translated","value":"Informazioni"}},"nl":{"stringUnit":{"state":"translated","value":"Over Publit"}},"pl":{"stringUnit":{"state":"translated","value":"O aplikacji"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Acerca"}},"ro":{"stringUnit":{"state":"translated","value":"Despre"}},"sv":{"stringUnit":{"state":"translated","value":"Om"}},"tr":{"stringUnit":{"state":"translated","value":"Hakkında"}},"uk":{"stringUnit":{"state":"translated","value":"Про застосунок"}}}},"About as fast":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Zhruba stejně rychle"}},"de":{"stringUnit":{"state":"translated","value":"Etwa gleich schnell"}},"el":{"stringUnit":{"state":"translated","value":"Περίπου το ίδιο"}},"en":{"stringUnit":{"state":"translated","value":"About as fast"}},"es":{"stringUnit":{"state":"translated","value":"Más o menos igual"}},"fr":{"stringUnit":{"state":"translated","value":"À peu près aussi rapide"}},"hu":{"stringUnit":{"state":"translated","value":"Nagyjából ugyanannyi"}},"it":{"stringUnit":{"state":"translated","value":"Circa uguale"}},"nl":{"stringUnit":{"state":"translated","value":"Ongeveer even snel"}},"pl":{"stringUnit":{"state":"translated","value":"Mniej więcej tak samo"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Mais ou menos igual"}},"ro":{"stringUnit":{"state":"translated","value":"Cam la fel de rapid"}},"sv":{"stringUnit":{"state":"translated","value":"Ungefär lika snabbt"}},"tr":{"stringUnit":{"state":"translated","value":"Aşağı yukarı aynı"}},"uk":{"stringUnit":{"state":"translated","value":"Приблизно так само"}}}},"About this pass":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"O této kartě"}},"de":{"stringUnit":{"state":"translated","value":"Über diesen Pass"}},"el":{"stringUnit":{"state":"translated","value":"Σχετικά με την κάρτα"}},"en":{"stringUnit":{"state":"translated","value":"About this pass"}},"es":{"stringUnit":{"state":"translated","value":"Sobre este pase"}},"fr":{"stringUnit":{"state":"translated","value":"À propos de ce pass"}},"hu":{"stringUnit":{"state":"translated","value":"A kártyáról"}},"it":{"stringUnit":{"state":"translated","value":"Informazioni su questo pass"}},"nl":{"stringUnit":{"state":"translated","value":"Over deze pas"}},"pl":{"stringUnit":{"state":"translated","value":"O tej karcie"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Sobre este passe"}},"ro":{"stringUnit":{"state":"translated","value":"Despre acest permis"}},"sv":{"stringUnit":{"state":"translated","value":"Om det här kortet"}},"tr":{"stringUnit":{"state":"translated","value":"Bu kart hakkında"}},"uk":{"stringUnit":{"state":"translated","value":"Про цю картку"}}}},"Active trip":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Probíhající cesta"}},"de":{"stringUnit":{"state":"translated","value":"Aktive Fahrt"}},"el":{"stringUnit":{"state":"translated","value":"Τρέχουσα διαδρομή"}},"en":{"stringUnit":{"state":"translated","value":"Active trip"}},"es":{"stringUnit":{"state":"translated","value":"Viaje en curso"}},"fr":{"stringUnit":{"state":"translated","value":"Trajet en cours"}},"hu":{"stringUnit":{"state":"translated","value":"Aktív utazás"}},"it":{"stringUnit":{"state":"translated","value":"Viaggio in corso"}},"nl":{"stringUnit":{"state":"translated","value":"Actieve reis"}},"pl":{"stringUnit":{"state":"translated","value":"Trwająca podróż"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Viagem em curso"}},"ro":{"stringUnit":{"state":"translated","value":"Călătorie în curs"}},"sv":{"stringUnit":{"state":"translated","value":"Pågående resa"}},"tr":{"stringUnit":{"state":"translated","value":"Etkin yolculuk"}},"uk":{"stringUnit":{"state":"translated","value":"Поточна поїздка"}}}},"Add":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Přidat"}},"de":{"stringUnit":{"state":"translated","value":"Hinzufügen"}},"el":{"stringUnit":{"state":"translated","value":"Προσθήκη"}},"en":{"stringUnit":{"state":"translated","value":"Add"}},"es":{"stringUnit":{"state":"translated","value":"Añadir"}},"fr":{"stringUnit":{"state":"translated","value":"Ajouter"}},"hu":{"stringUnit":{"state":"translated","value":"Hozzáadás"}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi"}},"nl":{"stringUnit":{"state":"translated","value":"Toevoegen"}},"pl":{"stringUnit":{"state":"translated","value":"Dodaj"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Adicionar"}},"ro":{"stringUnit":{"state":"translated","value":"Adăugați"}},"sv":{"stringUnit":{"state":"translated","value":"Lägg till"}},"tr":{"stringUnit":{"state":"translated","value":"Ekle"}},"uk":{"stringUnit":{"state":"translated","value":"Додати"}}}},"Add a screenshot of a pass such as KlimaTicket or Deutschlandticket, a one-way ticket, or a link to the app your ticket lives in.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Přidejte snímek časové jízdenky, např. KlimaTicket nebo Deutschlandticket, jednorázové jízdenky, nebo odkaz na aplikaci, ve které jízdenku máte."}},"de":{"stringUnit":{"state":"translated","value":"Füge einen Screenshot deines KlimaTickets, Deutschlandtickets oder Einzelfahrscheins hinzu oder einen Link zur Ticket-App."}},"el":{"stringUnit":{"state":"translated","value":"Προσθέστε στιγμιότυπο μιας κάρτας απεριορίστων διαδρομών, όπως KlimaTicket ή Deutschlandticket, ενός απλού εισιτηρίου ή έναν σύνδεσμο προς την εφαρμογή όπου βρίσκεται το εισιτήριό σας."}},"en":{"stringUnit":{"state":"translated","value":"Add a screenshot of a pass such as KlimaTicket or Deutschlandticket, a one-way ticket, or a link to the app that holds your ticket."}},"es":{"stringUnit":{"state":"translated","value":"Añade una captura de un abono como KlimaTicket o Deutschlandticket, de un billete sencillo, o un enlace a la app donde tienes el billete."}},"fr":{"stringUnit":{"state":"translated","value":"Ajoutez une capture d’écran d’un abonnement comme le KlimaTicket ou le Deutschlandticket, d’un billet simple, ou un lien vers l’app où se trouve votre billet."}},"hu":{"stringUnit":{"state":"translated","value":"Adj hozzá képernyőképet egy bérletről, például KlimaTicketről vagy Deutschlandticketről, egy vonaljegyről, vagy linket az apphoz, amelyben a jegyed van."}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi lo screenshot di un abbonamento come KlimaTicket o Deutschlandticket, di un biglietto singolo, oppure un link all’app in cui si trova il biglietto."}},"nl":{"stringUnit":{"state":"translated","value":"Voeg een screenshot toe van een abonnement zoals KlimaTicket of Deutschlandticket, van een los ticket, of een link naar de app waarin je ticket staat."}},"pl":{"stringUnit":{"state":"translated","value":"Dodaj zrzut ekranu biletu okresowego, np. KlimaTicket lub Deutschlandticket, biletu jednorazowego albo link do aplikacji, w której masz bilet."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Adicione uma captura de ecrã de um passe como o KlimaTicket ou o Deutschlandticket, de um bilhete simples, ou uma ligação para a app onde está o bilhete."}},"ro":{"stringUnit":{"state":"translated","value":"Adăugați o captură de ecran a unui abonament precum KlimaTicket sau Deutschlandticket, a unui bilet simplu sau un link către aplicația în care aveți biletul."}},"sv":{"stringUnit":{"state":"translated","value":"Lägg till en skärmbild av ett periodkort som KlimaTicket eller Deutschlandticket, en enkelbiljett, eller en länk till appen där biljetten finns."}},"tr":{"stringUnit":{"state":"translated","value":"KlimaTicket veya Deutschlandticket gibi bir abonmanın, tek yön biletin ekran görüntüsünü ya da biletinizin bulunduğu uygulamanın bağlantısını ekleyin."}},"uk":{"stringUnit":{"state":"translated","value":"Додайте знімок проїзного, як-от KlimaTicket чи Deutschlandticket, разового квитка або посилання на застосунок, де зберігається квиток."}}}},"Add a ticket from a PDF, a photo or a screenshot. Publit reads the details on your iPhone and keeps the code ready for the gate.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Přidej jízdenku z PDF, fotky nebo snímku obrazovky. Publit přečte údaje přímo v iPhonu a připraví kód pro turniket."}},"de":{"stringUnit":{"state":"translated","value":"Füge ein Ticket aus einem PDF, einem Foto oder einem Screenshot hinzu. Publit liest die Angaben auf deinem iPhone und hält den Code für die Sperre bereit."}},"el":{"stringUnit":{"state":"translated","value":"Πρόσθεσε εισιτήριο από PDF, φωτογραφία ή στιγμιότυπο οθόνης. Το Publit διαβάζει τα στοιχεία στο iPhone σου και κρατά τον κωδικό έτοιμο για την μπάρα."}},"en":{"stringUnit":{"state":"translated","value":"Add a ticket from a PDF, a photo or a screenshot. Publit reads the details on your iPhone and keeps the code ready for the gate."}},"es":{"stringUnit":{"state":"translated","value":"Añade un billete desde un PDF, una foto o una captura de pantalla. Publit lee los datos en tu iPhone y deja el código listo para el torno."}},"fr":{"stringUnit":{"state":"translated","value":"Ajoute un billet depuis un PDF, une photo ou une capture d’écran. Publit lit les infos sur ton iPhone et garde le code prêt pour le portique."}},"hu":{"stringUnit":{"state":"translated","value":"Adj hozzá jegyet PDF-ből, fotóból vagy képernyőképből. A Publit az iPhone-odon olvassa ki az adatokat, és kéznél tartja a kódot a beléptetőhöz."}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi un biglietto da un PDF, una foto o uno screenshot. Publit legge i dati sul tuo iPhone e tiene pronto il codice per il tornello."}},"nl":{"stringUnit":{"state":"translated","value":"Voeg een ticket toe uit een pdf, foto of screenshot. Publit leest de gegevens op je iPhone en houdt de code klaar voor het poortje."}},"pl":{"stringUnit":{"state":"translated","value":"Dodaj bilet z pliku PDF, zdjęcia lub zrzutu ekranu. Publit odczyta dane na iPhonie i przygotuje kod do bramki."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Adiciona um bilhete a partir de um PDF, de uma foto ou de uma captura de ecrã. O Publit lê os dados no teu iPhone e tem o código pronto para a cancela."}},"ro":{"stringUnit":{"state":"translated","value":"Adaugă un bilet dintr-un PDF, o fotografie sau o captură de ecran. Publit citește datele pe iPhone și ține codul pregătit pentru barieră."}},"sv":{"stringUnit":{"state":"translated","value":"Lägg till en biljett från en pdf, ett foto eller en skärmbild. Publit läser uppgifterna på din iPhone och har koden redo vid spärren."}},"tr":{"stringUnit":{"state":"translated","value":"PDF, fotoğraf ya da ekran görüntüsünden bilet ekle. Publit bilgileri iPhone’unda okur ve kodu turnike için hazır tutar."}},"uk":{"stringUnit":{"state":"translated","value":"Додай квиток із PDF, фото чи знімка екрана. Publit прочитає дані на твоєму iPhone і тримає код напоготові для турнікета."}}}},"Add the ticket from a PDF, a photo or a screenshot. Day, weekly and annual passes show up for every trip while they are valid.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Přidejte jízdenku z PDF, fotky nebo snímku obrazovky. Denní, týdenní a roční jízdenky se zobrazí u každé cesty, dokud platí."}},"de":{"stringUnit":{"state":"translated","value":"Füge das Ticket aus einem PDF, einem Foto oder einem Screenshot hinzu. Tages-, Wochen- und Jahreskarten erscheinen bei jeder Fahrt, solange sie gültig sind."}},"el":{"stringUnit":{"state":"translated","value":"Προσθέστε το εισιτήριο από PDF, φωτογραφία ή στιγμιότυπο οθόνης. Οι ημερήσιες, εβδομαδιαίες και ετήσιες κάρτες εμφανίζονται σε κάθε διαδρομή όσο ισχύουν."}},"en":{"stringUnit":{"state":"translated","value":"Add the ticket from a PDF, a photo or a screenshot. Day, weekly and annual passes show up for every trip while they are valid."}},"es":{"stringUnit":{"state":"translated","value":"Añade el billete desde un PDF, una foto o una captura de pantalla. Los abonos de día, semana y año aparecen en cada viaje mientras sean válidos."}},"fr":{"stringUnit":{"state":"translated","value":"Ajoutez le billet depuis un PDF, une photo ou une capture d’écran. Les forfaits jour, semaine et annuels apparaissent pour chaque trajet tant qu’ils sont valables."}},"hu":{"stringUnit":{"state":"translated","value":"Add hozzá a jegyet PDF-ből, fotóról vagy képernyőképről. A napi, heti és éves bérletek minden utazásnál megjelennek, amíg érvényesek."}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi il biglietto da un PDF, una foto o uno screenshot. Gli abbonamenti giornalieri, settimanali e annuali compaiono per ogni viaggio finché sono validi."}},"nl":{"stringUnit":{"state":"translated","value":"Voeg het ticket toe uit een pdf, een foto of een screenshot. Dag-, week- en jaarabonnementen verschijnen bij elke reis zolang ze geldig zijn."}},"pl":{"stringUnit":{"state":"translated","value":"Dodaj bilet z pliku PDF, zdjęcia lub zrzutu ekranu. Bilety dobowe, tygodniowe i roczne pojawiają się przy każdej podróży, dopóki są ważne."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Adicione o bilhete a partir de um PDF, de uma foto ou de uma captura de ecrã. Os passes diários, semanais e anuais aparecem em cada viagem enquanto forem válidos."}},"ro":{"stringUnit":{"state":"translated","value":"Adaugă biletul dintr-un PDF, o fotografie sau o captură de ecran. Abonamentele de o zi, o săptămână sau un an apar la fiecare călătorie cât timp sunt valabile."}},"sv":{"stringUnit":{"state":"translated","value":"Lägg till biljetten från en pdf, ett foto eller en skärmbild. Dags-, vecko- och årskort visas för varje resa så länge de gäller."}},"tr":{"stringUnit":{"state":"translated","value":"Bileti bir PDF’ten, fotoğraftan veya ekran görüntüsünden ekleyin. Günlük, haftalık ve yıllık kartlar geçerli oldukları sürece her yolculukta görünür."}},"uk":{"stringUnit":{"state":"translated","value":"Додайте квиток із PDF, фото чи знімка екрана. Денні, тижневі та річні проїзні з’являються для кожної поїздки, поки вони дійсні."}}}},"Add ticket":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Přidat jízdenku"}},"de":{"stringUnit":{"state":"translated","value":"Ticket hinzufügen"}},"el":{"stringUnit":{"state":"translated","value":"Προσθήκη εισιτηρίου"}},"en":{"stringUnit":{"state":"translated","value":"Add ticket"}},"es":{"stringUnit":{"state":"translated","value":"Añadir billete"}},"fr":{"stringUnit":{"state":"translated","value":"Ajouter un billet"}},"hu":{"stringUnit":{"state":"translated","value":"Jegy hozzáadása"}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi biglietto"}},"nl":{"stringUnit":{"state":"translated","value":"Ticket toevoegen"}},"pl":{"stringUnit":{"state":"translated","value":"Dodaj bilet"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Adicionar bilhete"}},"ro":{"stringUnit":{"state":"translated","value":"Adăugați bilet"}},"sv":{"stringUnit":{"state":"translated","value":"Lägg till biljett"}},"tr":{"stringUnit":{"state":"translated","value":"Bilet ekle"}},"uk":{"stringUnit":{"state":"translated","value":"Додати квиток"}}}},"Add ticket for this trip":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Přidat jízdenku k této cestě"}},"de":{"stringUnit":{"state":"translated","value":"Ticket für diese Fahrt hinzufügen"}},"el":{"stringUnit":{"state":"translated","value":"Προσθήκη εισιτηρίου για αυτή τη διαδρομή"}},"en":{"stringUnit":{"state":"translated","value":"Add ticket for this trip"}},"es":{"stringUnit":{"state":"translated","value":"Añadir billete para este viaje"}},"fr":{"stringUnit":{"state":"translated","value":"Ajouter un billet pour ce trajet"}},"hu":{"stringUnit":{"state":"translated","value":"Jegy hozzáadása ehhez az utazáshoz"}},"it":{"stringUnit":{"state":"translated","value":"Aggiungi biglietto per questo viaggio"}},"nl":{"stringUnit":{"state":"translated","value":"Ticket voor deze reis toevoegen"}},"pl":{"stringUnit":{"state":"translated","value":"Dodaj bilet do tej podróży"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Adicionar bilhete para esta viagem"}},"ro":{"stringUnit":{"state":"translated","value":