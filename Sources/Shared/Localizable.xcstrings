:"translated","value":"Posizione secondo l'orario"}},"nl":{"stringUnit":{"state":"translated","value":"Positie volgens dienstregeling"}},"pl":{"stringUnit":{"state":"translated","value":"Pozycja według rozkładu"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Posição segundo o horário"}},"ro":{"stringUnit":{"state":"translated","value":"Poziție conform orarului"}},"sv":{"stringUnit":{"state":"translated","value":"Position enligt tidtabell"}},"tr":{"stringUnit":{"state":"translated","value":"Tarifeye göre konum"}},"uk":{"stringUnit":{"state":"translated","value":"Позиція за розкладом"}}}},"Position from your location.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Poloha podle vaší polohy."}},"de":{"stringUnit":{"state":"translated","value":"Position aus deinem Standort."}},"el":{"stringUnit":{"state":"translated","value":"Θέση από την τοποθεσία σας."}},"en":{"stringUnit":{"state":"translated","value":"Position from your location."}},"es":{"stringUnit":{"state":"translated","value":"Posición según su ubicación."}},"fr":{"stringUnit":{"state":"translated","value":"Position d’après votre localisation."}},"hu":{"stringUnit":{"state":"translated","value":"A helyzet a tartózkodási helye alapján."}},"it":{"stringUnit":{"state":"translated","value":"Posizione dalla tua posizione."}},"nl":{"stringUnit":{"state":"translated","value":"Positie op basis van je locatie."}},"pl":{"stringUnit":{"state":"translated","value":"Pozycja z Twojej lokalizacji."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Posição a partir da sua localização."}},"ro":{"stringUnit":{"state":"translated","value":"Poziție după locația dvs."}},"sv":{"stringUnit":{"state":"translated","value":"Position från din plats."}},"tr":{"stringUnit":{"state":"translated","value":"Konum, bulunduğunuz yere göre."}},"uk":{"stringUnit":{"state":"translated","value":"Позиція за вашим місцезнаходженням."}}}},"Preview: %@":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Náhled: %@"}},"de":{"stringUnit":{"state":"translated","value":"Vorschau: %@"}},"el":{"stringUnit":{"state":"translated","value":"Προεπισκόπηση: %@"}},"en":{"stringUnit":{"state":"translated","value":"Preview: %@"}},"es":{"stringUnit":{"state":"translated","value":"Vista previa: %@"}},"fr":{"stringUnit":{"state":"translated","value":"Aperçu : %@"}},"hu":{"stringUnit":{"state":"translated","value":"Előnézet: %@"}},"it":{"stringUnit":{"state":"translated","value":"Anteprima: %@"}},"nl":{"stringUnit":{"state":"translated","value":"Voorbeeld: %@"}},"pl":{"stringUnit":{"state":"translated","value":"Podgląd: %@"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Pré-visualização: %@"}},"ro":{"stringUnit":{"state":"translated","value":"Previzualizare: %@"}},"sv":{"stringUnit":{"state":"translated","value":"Förhandsvisning: %@"}},"tr":{"stringUnit":{"state":"translated","value":"Önizleme: %@"}},"uk":{"stringUnit":{"state":"translated","value":"Попередній перегляд: %@"}}}},"Price":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Cena"}},"de":{"stringUnit":{"state":"translated","value":"Preis"}},"el":{"stringUnit":{"state":"translated","value":"Τιμή"}},"en":{"stringUnit":{"state":"translated","value":"Price"}},"es":{"stringUnit":{"state":"translated","value":"Precio"}},"fr":{"stringUnit":{"state":"translated","value":"Prix"}},"hu":{"stringUnit":{"state":"translated","value":"Ár"}},"it":{"stringUnit":{"state":"translated","value":"Prezzo"}},"nl":{"stringUnit":{"state":"translated","value":"Prijs"}},"pl":{"stringUnit":{"state":"translated","value":"Cena"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Preço"}},"ro":{"stringUnit":{"state":"translated","value":"Preț"}},"sv":{"stringUnit":{"state":"translated","value":"Pris"}},"tr":{"stringUnit":{"state":"translated","value":"Fiyat"}},"uk":{"stringUnit":{"state":"translated","value":"Ціна"}}}},"Provider":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Poskytovatel"}},"de":{"stringUnit":{"state":"translated","value":"Anbieter"}},"el":{"stringUnit":{"state":"translated","value":"Πάροχος"}},"en":{"stringUnit":{"state":"translated","value":"Provider"}},"es":{"stringUnit":{"state":"translated","value":"Proveedor"}},"fr":{"stringUnit":{"state":"translated","value":"Fournisseur"}},"hu":{"stringUnit":{"state":"translated","value":"Szolgáltató"}},"it":{"stringUnit":{"state":"translated","value":"Gestore"}},"nl":{"stringUnit":{"state":"translated","value":"Aanbieder"}},"pl":{"stringUnit":{"state":"translated","value":"Operator"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Fornecedor"}},"ro":{"stringUnit":{"state":"translated","value":"Furnizor"}},"sv":{"stringUnit":{"state":"translated","value":"Leverantör"}},"tr":{"stringUnit":{"state":"translated","value":"Sağlayıcı"}},"uk":{"stringUnit":{"state":"translated","value":"Оператор"}}}},"Public transport, without the noise.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Veřejná doprava bez zbytečností."}},"de":{"stringUnit":{"state":"translated","value":"Öffentlicher Verkehr ohne Ablenkung."}},"el":{"stringUnit":{"state":"translated","value":"Συγκοινωνίες, χωρίς θόρυβο."}},"en":{"stringUnit":{"state":"translated","value":"Public transport, without the noise."}},"es":{"stringUnit":{"state":"translated","value":"Transporte público, sin ruido."}},"fr":{"stringUnit":{"state":"translated","value":"Les transports publics, sans le bruit."}},"hu":{"stringUnit":{"state":"translated","value":"Tömegközlekedés, zaj nélkül."}},"it":{"stringUnit":{"state":"translated","value":"Trasporto pubblico, senza rumore."}},"nl":{"stringUnit":{"state":"translated","value":"Openbaar vervoer, zonder ruis."}},"pl":{"stringUnit":{"state":"translated","value":"Komunikacja publiczna, bez zbędnego szumu."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Transportes públicos, sem ruído."}},"ro":{"stringUnit":{"state":"translated","value":"Transport public, fără zgomot."}},"sv":{"stringUnit":{"state":"translated","value":"Kollektivtrafik, utan brus."}},"tr":{"stringUnit":{"state":"translated","value":"Toplu taşıma, gürültüsüz."}},"uk":{"stringUnit":{"state":"translated","value":"Громадський транспорт без зайвого."}}}},"Publit checks your saved lines when you open it and from time to time in the background (iOS decides when), and tells you about alerts and cancelled departures.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Publit kontroluje uložené linky při otevření a občas na pozadí (kdy, rozhoduje iOS) a upozorní na výluky a zrušené spoje."}},"de":{"stringUnit":{"state":"translated","value":"Publit prüft deine gemerkten Linien beim Öffnen und ab und zu im Hintergrund (wann, entscheidet iOS) und meldet Störungen und ausfallende Fahrten."}},"el":{"stringUnit":{"state":"translated","value":"Το Publit ελέγχει τις αποθηκευμένες γραμμές όταν το ανοίγεις και κατά διαστήματα στο παρασκήνιο (το iOS αποφασίζει πότε) και σε ενημερώνει για διαταραχές και ακυρωμένες αναχωρήσεις."}},"en":{"stringUnit":{"state":"translated","value":"Publit checks your saved lines when you open it and from time to time in the background (iOS decides when), and tells you about alerts and cancelled departures."}},"es":{"stringUnit":{"state":"translated","value":"Publit revisa tus líneas guardadas al abrirla y de vez en cuando en segundo plano (iOS decide cuándo) y te avisa de incidencias y salidas canceladas."}},"fr":{"stringUnit":{"state":"translated","value":"Publit vérifie vos lignes enregistrées à l'ouverture et de temps en temps en arrière-plan (iOS décide quand), et vous signale les perturbations et les départs supprimés."}},"hu":{"stringUnit":{"state":"translated","value":"A Publit megnyitáskor és időnként a háttérben (hogy mikor, azt az iOS dönti el) ellenőrzi a mentett vonalakat, és jelzi a zavarokat és az elmaradó járatokat."}},"it":{"stringUnit":{"state":"translated","value":"Publit controlla le linee salvate all'apertura e di tanto in tanto in background (decide iOS quando) e ti avvisa di disservizi e corse soppresse."}},"nl":{"stringUnit":{"state":"translated","value":"Publit controleert je bewaarde lijnen bij het openen en af en toe op de achtergrond (iOS bepaalt wanneer) en meldt storingen en vervallen ritten."}},"pl":{"stringUnit":{"state":"translated","value":"Publit sprawdza zapisane linie przy otwarciu i od czasu do czasu w tle (iOS decyduje kiedy) oraz informuje o utrudnieniach i odwołanych kursach."}},"pt-PT":{"stringUnit":{"state":"translated","value":"A Publit verifica as linhas guardadas ao abrir e de vez em quando em segundo plano (o iOS decide quando) e avisa sobre perturbações e partidas canceladas."}},"ro":{"stringUnit":{"state":"translated","value":"Publit verifică liniile salvate la deschidere și din când în când în fundal (iOS decide când) și te anunță despre perturbări și plecări anulate."}},"sv":{"stringUnit":{"state":"translated","value":"Publit kontrollerar dina sparade linjer när du öppnar appen och då och då i bakgrunden (iOS bestämmer när) och meddelar störningar och inställda avgångar."}},"tr":{"stringUnit":{"state":"translated","value":"Publit kayıtlı hatlarını açılışta ve zaman zaman arka planda (ne zaman olacağına iOS karar verir) kontrol eder; aksaklıkları ve iptal edilen seferleri bildirir."}},"uk":{"stringUnit":{"state":"translated","value":"Publit перевіряє збережені лінії під час відкриття і час від часу у фоні (коли — вирішує iOS) та повідомляє про збої й скасовані рейси."}}}},"Publit is open source (MIT). No account, no ads, no tracking. Saved places and trips stay on this device.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Publit je open source (MIT). Žádný účet, žádné reklamy, žádné sledování. Uložená místa a cesty zůstávají v tomto zařízení."}},"de":{"stringUnit":{"state":"translated","value":"Publit ist Open Source (MIT). Kein Konto, keine Werbung, kein Tracking. Gespeicherte Orte und Fahrten bleiben auf diesem Gerät."}},"el":{"stringUnit":{"state":"translated","value":"Το Publit είναι ανοιχτού κώδικα (MIT). Χωρίς λογαριασμό, χωρίς διαφημίσεις, χωρίς παρακολούθηση. Οι αποθηκευμένες τοποθεσίες και διαδρομές μένουν σε αυτή τη συσκευή."}},"en":{"stringUnit":{"state":"translated","value":"Publit is open source (MIT). No account, no ads, no tracking. Saved places and trips stay on this device."}},"es":{"stringUnit":{"state":"translated","value":"Publit es de código abierto (MIT). Sin cuenta, sin anuncios, sin rastreo. Tus lugares y viajes guardados se quedan en este dispositivo."}},"fr":{"stringUnit":{"state":"translated","value":"Publit est open source (MIT). Sans compte, sans publicité, sans pistage. Vos lieux et trajets restent sur cet appareil."}},"hu":{"stringUnit":{"state":"translated","value":"A Publit nyílt forráskódú (MIT). Nincs fiók, nincs reklám, nincs követés. A mentett helyek és utazások ezen az eszközön maradnak."}},"it":{"stringUnit":{"state":"translated","value":"Publit è open source (MIT). Nessun account, nessuna pubblicità, nessun tracciamento. Luoghi e viaggi salvati restano su questo dispositivo."}},"nl":{"stringUnit":{"state":"translated","value":"Publit is open source (MIT). Geen account, geen advertenties, geen tracking. Bewaarde plaatsen en reizen blijven op dit apparaat."}},"pl":{"stringUnit":{"state":"translated","value":"Publit jest open source (MIT). Bez konta, bez reklam, bez śledzenia. Zapisane miejsca i podróże zostają na tym urządzeniu."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Publit é open source (MIT). Sem conta, sem anúncios, sem rastreio. Locais e viagens guardados ficam neste dispositivo."}},"ro":{"stringUnit":{"state":"translated","value":"Publit este open source (MIT). Fără cont, fără reclame, fără urmărire. Locurile și călătoriile salvate rămân pe acest dispozitiv."}},"sv":{"stringUnit":{"state":"translated","value":"Publit är öppen källkod (MIT). Inget konto, ingen reklam, ingen spårning. Sparade platser och resor stannar på enheten."}},"tr":{"stringUnit":{"state":"translated","value":"Publit açık kaynaklıdır (MIT). Hesap yok, reklam yok, takip yok. Kayıtlı yerler ve yolculuklar bu cihazda kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Publit має відкритий код (MIT). Без облікового запису, без реклами, без стеження. Збережені місця й поїздки залишаються на цьому пристрої."}}}},"Publit is open source (MIT). No account, no ads, no tracking. Saved places, trips and tickets stay on this device.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Publit je open source (MIT). Žádný účet, žádné reklamy, žádné sledování. Uložená místa, cesty a jízdenky zůstávají v tomto zařízení."}},"de":{"stringUnit":{"state":"translated","value":"Publit ist Open Source (MIT). Kein Konto, keine Werbung, kein Tracking. Gespeicherte Orte, Fahrten und Tickets bleiben auf diesem Gerät."}},"el":{"stringUnit":{"state":"translated","value":"Το Publit είναι ανοιχτού κώδικα (MIT). Χωρίς λογαριασμό, χωρίς διαφημίσεις, χωρίς παρακολούθηση. Οι αποθηκευμένες τοποθεσίες, διαδρομές και εισιτήρια μένουν σε αυτή τη συσκευή."}},"en":{"stringUnit":{"state":"translated","value":"Publit is open source (MIT). No account, no ads, no tracking. Saved places, trips and tickets stay on this device."}},"es":{"stringUnit":{"state":"translated","value":"Publit es de código abierto (MIT). Sin cuenta, sin anuncios, sin rastreo. Tus lugares, viajes y billetes guardados se quedan en este dispositivo."}},"fr":{"stringUnit":{"state":"translated","value":"Publit est open source (MIT). Sans compte, sans publicité, sans pistage. Vos lieux, trajets et billets restent sur cet appareil."}},"hu":{"stringUnit":{"state":"translated","value":"A Publit nyílt forráskódú (MIT). Nincs fiók, nincs reklám, nincs követés. A mentett helyek, utazások és jegyek ezen az eszközön maradnak."}},"it":{"stringUnit":{"state":"translated","value":"Publit è open source (MIT). Nessun account, nessuna pubblicità, nessun tracciamento. Luoghi, viaggi e biglietti salvati restano su questo dispositivo."}},"nl":{"stringUnit":{"state":"translated","value":"Publit is open source (MIT). Geen account, geen advertenties, geen tracking. Bewaarde plaatsen, reizen en tickets blijven op dit apparaat."}},"pl":{"stringUnit":{"state":"translated","value":"Publit jest open source (MIT). Bez konta, bez reklam, bez śledzenia. Zapisane miejsca, podróże i bilety zostają na tym urządzeniu."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Publit é open source (MIT). Sem conta, sem anúncios, sem rastreio. Locais, viagens e bilhetes guardados ficam neste dispositivo."}},"ro":{"stringUnit":{"state":"translated","value":"Publit este open source (MIT). Fără cont, fără reclame, fără urmărire. Locurile, călătoriile și biletele salvate rămân pe acest dispozitiv."}},"sv":{"stringUnit":{"state":"translated","value":"Publit är öppen källkod (MIT). Inget konto, ingen reklam, ingen spårning. Sparade platser, resor och biljetter stannar på enheten."}},"tr":{"stringUnit":{"state":"translated","value":"Publit açık kaynaklıdır (MIT). Hesap yok, reklam yok, takip yok. Kayıtlı yerler, yolculuklar ve biletler bu cihazda kalır."}},"uk":{"stringUnit":{"state":"translated","value":"Publit має відкритий код (MIT). Без облікового запису, без реклами, без стеження. Збережені місця, поїздки й квитки залишаються на цьому пристрої."}}}},"Publit notes freezes of 2 seconds or more, crashes, unexpected exits and failed requests (only their kind), each with the screens opened just before. Places, stops and tickets are not recorded, and nothing leaves this device unless you share it.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Publit zaznamenává zamrznutí od 2 sekund, pády, neočekávaná ukončení a neúspěšné požadavky (jen jejich druh) spolu s obrazovkami otevřenými těsně předtím. Místa, zastávky a jízdenky se nezaznamenávají a nic neopustí toto zařízení, pokud to nesdílíte."}},"de":{"stringUnit":{"state":"translated","value":"Publit notiert Hänger ab 2 Sekunden, Abstürze, unerwartete Beendigungen und fehlgeschlagene Anfragen (nur deren Art), jeweils mit den kurz davor geöffneten Ansichten. Orte, Haltestellen und Tickets werden nicht aufgezeichnet, und nichts verlässt dieses Gerät, außer du teilst es."}},"el":{"stringUnit":{"state":"translated","value":"Το Publit καταγράφει παγώματα 2 δευτερολέπτων ή περισσότερο, σφάλματα, απροσδόκητους τερματισμούς και αποτυχημένα αιτήματα (μόνο το είδος τους), μαζί με τις οθόνες που άνοιξαν λίγο πριν. Τοποθεσίες, στάσεις και εισιτήρια δεν καταγράφονται και τίποτα δεν φεύγει από αυτή τη συσκευή αν δεν το κοινοποιήσεις."}},"en":{"stringUnit":{"state":"translated","value":"Publit notes freezes of 2 seconds or more, crashes, unexpected exits and failed requests (only their kind), each with the screens opened just before. Places, stops and tickets are not recorded, and nothing leaves this device unless you share it."}},"es":{"stringUnit":{"state":"translated","value":"Publit anota bloqueos de 2 segundos o más, fallos, cierres inesperados y solicitudes fallidas (solo su tipo), con las pantallas abiertas justo antes. No se registran lugares, paradas ni billetes, y nada sale de este dispositivo salvo que lo compartas."}},"fr":{"stringUnit":{"state":"translated","value":"Publit note les blocages de 2 secondes ou plus, les plantages, les fermetures inattendues et les requêtes échouées (seulement leur type), avec les écrans ouverts juste avant. Les lieux, arrêts et billets ne sont pas enregistrés, et rien ne quitte cet appareil sauf si vous le partagez."}},"hu":{"stringUnit":{"state":"translated","value":"A Publit rögzíti a legalább 2 másodperces lefagyásokat, összeomlásokat, váratlan kilépéseket és sikertelen kéréseket (csak a fajtájukat), a közvetlenül előtte megnyitott képernyőkkel együtt. Helyeket, megállókat és jegyeket nem rögzít, és semmi sem hagyja el az eszközt, hacsak meg nem osztod."}},"it":{"stringUnit":{"state":"translated","value":"Publit annota blocchi di 2 secondi o più, arresti anomali, chiusure impreviste e richieste non riuscite (solo il tipo), con le schermate aperte poco prima. Luoghi, fermate e biglietti non vengono registrati e nulla lascia questo dispositivo se non lo condividi."}},"nl":{"stringUnit":{"state":"translated","value":"Publit noteert vastlopers van 2 seconden of langer, crashes, onverwachte afsluitingen en mislukte verzoeken (alleen het soort), met de schermen die vlak daarvoor open waren. Plaatsen, haltes en tickets worden niet vastgelegd, en niets verlaat dit apparaat tenzij je het deelt."}},"pl":{"stringUnit":{"state":"translated","value":"Publit zapisuje zawieszenia trwające 2 sekundy lub dłużej, awarie, nieoczekiwane zamknięcia i nieudane zapytania (tylko ich rodzaj) wraz z ekranami otwartymi tuż przedtem. Miejsca, przystanki i bilety nie są zapisywane i nic nie opuszcza tego urządzenia, chyba że to udostępnisz."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Publit regista bloqueios de 2 segundos ou mais, falhas, encerramentos inesperados e pedidos falhados (apenas o tipo), com os ecrãs abertos imediatamente antes. Locais, paragens e bilhetes não são registados e nada sai deste dispositivo, a menos que o partilhe."}},"ro":{"stringUnit":{"state":"translated","value":"Publit notează blocările de 2 secunde sau mai mult, blocările fatale, închiderile neașteptate și cererile eșuate (doar tipul lor), împreună cu ecranele deschise chiar înainte. Locurile, stațiile și biletele nu sunt înregistrate și nimic nu părăsește acest dispozitiv decât dacă îl partajezi."}},"sv":{"stringUnit":{"state":"translated","value":"Publit noterar frysningar på 2 sekunder eller mer, krascher, oväntade avslut och misslyckade förfrågningar (bara typen), med skärmarna som öppnades strax innan. Platser, hållplatser och biljetter registreras inte, och inget lämnar enheten om du inte delar det."}},"tr":{"stringUnit":{"state":"translated","value":"Publit 2 saniye veya daha uzun donmaları, çökmeleri, beklenmedik kapanmaları ve başarısız istekleri (yalnızca türlerini), hemen öncesinde açılan ekranlarla birlikte kaydeder. Yerler, duraklar ve biletler kaydedilmez ve sen paylaşmadıkça hiçbir şey bu cihazdan çıkmaz."}},"uk":{"stringUnit":{"state":"translated","value":"Publit фіксує зависання від 2 секунд, збої, неочікувані завершення та невдалі запити (лише їхній тип) разом з екранами, відкритими безпосередньо перед цим. Місця, зупинки й квитки не записуються, і ніщо не залишає цей пристрій, якщо ви цим не поділитеся."}}}},"Publit reads the ticket on your iPhone. Nothing is uploaded. Codes that change every few seconds only work in the operator's app.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Publit čte jízdenku přímo v iPhonu. Nic se nenahrává. Kódy, které se mění každých pár sekund, fungují jen v aplikaci dopravce."}},"de":{"stringUnit":{"state":"translated","value":"Publit liest das Ticket auf deinem iPhone. Nichts wird hochgeladen. Codes, die sich alle paar Sekunden ändern, funktionieren nur in der App des Verkehrsunternehmens."}},"el":{"stringUnit":{"state":"translated","value":"Το Publit διαβάζει το εισιτήριο στο iPhone σου. Δεν ανεβαίνει τίποτα. Κωδικοί που αλλάζουν κάθε λίγα δευτερόλεπτα λειτουργούν μόνο στην εφαρμογή του φορέα."}},"en":{"stringUnit":{"state":"translated","value":"Publit reads the ticket on your iPhone. Nothing is uploaded. Codes that change every few seconds only work in the operator's app."}},"es":{"stringUnit":{"state":"translated","value":"Publit lee el billete en tu iPhone. No se sube nada. Los códigos que cambian cada pocos segundos solo funcionan en la app del operador."}},"fr":{"stringUnit":{"state":"translated","value":"Publit lit le billet sur ton iPhone. Rien n’est envoyé. Les codes qui changent toutes les quelques secondes ne marchent que dans l’app de l’opérateur."}},"hu":{"stringUnit":{"state":"translated","value":"A Publit az iPhone-odon olvassa ki a jegyet. Semmi sem kerül feltöltésre. A néhány másodpercenként változó kódok csak a szolgáltató appjában működnek."}},"it":{"stringUnit":{"state":"translated","value":"Publit legge il biglietto sul tuo iPhone. Non viene caricato nulla. I codici che cambiano ogni pochi secondi funzionano solo nell’app dell’operatore."}},"nl":{"stringUnit":{"state":"translated","value":"Publit leest het ticket op je iPhone. Er wordt niets geüpload. Codes die elke paar seconden veranderen werken alleen in de app van de vervoerder."}},"pl":{"stringUnit":{"state":"translated","value":"Publit odczytuje bilet na iPhonie. Nic nie jest wysyłane. Kody zmieniające się co kilka sekund działają tylko w aplikacji przewoźnika."}},"pt-PT":{"stringUnit":{"state":"translated","value":"O Publit lê o bilhete no teu iPhone. Nada é enviado. Os códigos que mudam a cada poucos segundos só funcionam na app do operador."}},"ro":{"stringUnit":{"state":"translated","value":"Publit citește biletul pe iPhone. Nu se încarcă nimic. Codurile care se schimbă la câteva secunde merg doar în aplicația operatorului."}},"sv":{"stringUnit":{"state":"translated","value":"Publit läser biljetten på din iPhone. Inget laddas upp. Koder som byts ut med några sekunders mellanrum fungerar bara i trafikbolagets app."}},"tr":{"stringUnit":{"state":"translated","value":"Publit bileti iPhone’unda okur. Hiçbir şey yüklenmez. Birkaç saniyede bir değişen kodlar yalnızca işletmecinin uygulamasında çalışır."}},"uk":{"stringUnit":{"state":"translated","value":"Publit читає квиток на твоєму iPhone. Нічого не завантажується. Коди, що змінюються кожні кілька секунд, працюють тільки в застосунку перевізника."}}}},"Purple":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Fialová"}},"de":{"stringUnit":{"state":"translated","value":"Lila"}},"el":{"stringUnit":{"state":"translated","value":"Μωβ"}},"en":{"stringUnit":{"state":"translated","value":"Purple"}},"es":{"stringUnit":{"state":"translated","value":"Morado"}},"fr":{"stringUnit":{"state":"translated","value":"Violet"}},"hu":{"stringUnit":{"state":"translated","value":"Lila"}},"it":{"stringUnit":{"state":"translated","value":"Viola"}},"nl":{"stringUnit":{"state":"translated","value":"Paars"}},"pl":{"stringUnit":{"state":"translated","value":"Fioletowy"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Roxo"}},"ro":{"stringUnit":{"state":"translated","value":"Violet"}},"sv":{"stringUnit":{"state":"translated","value":"Lila"}},"tr":{"stringUnit":{"state":"translated","value":"Mor"}},"uk":{"stringUnit":{"state":"translated","value":"Фіолетовий"}}}},"Quick":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Rychlé cíle"}},"de":{"stringUnit":{"state":"translated","value":"Schnellziele"}},"el":{"stringUnit":{"state":"translated","value":"Γρήγορα"}},"en":{"stringUnit":{"state":"translated","value":"Quick"}},"es":{"stringUnit":{"state":"translated","value":"Accesos rápidos"}},"fr":{"stringUnit":{"state":"translated","value":"Raccourcis"}},"hu":{"stringUnit":{"state":"translated","value":"Gyors célok"}},"it":{"stringUnit":{"state":"translated","value":"Rapidi"}},"nl":{"stringUnit":{"state":"translated","value":"Snelkoppelingen"}},"pl":{"stringUnit":{"state":"translated","value":"Szybki wybór"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Atalhos"}},"ro":{"stringUnit":{"state":"translated","value":"Rapid"}},"sv":{"stringUnit":{"state":"translated","value":"Snabbval"}},"tr":{"stringUnit":{"state":"translated","value":"Hızlı erişim"}},"uk":{"stringUnit":{"state":"translated","value":"Швидкий вибір"}}}},"Rail replacement bus":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Náhradní autobusová doprava"}},"de":{"stringUnit":{"state":"translated","value":"Schienenersatzverkehr"}},"el":{"stringUnit":{"state":"translated","value":"Λεωφορείο αντικατάστασης"}},"en":{"stringUnit":{"state":"translated","value":"Rail replacement bus"}},"es":{"stringUnit":{"state":"translated","value":"Autobús sustitutorio"}},"fr":{"stringUnit":{"state":"translated","value":"Bus de substitution"}},"hu":{"stringUnit":{"state":"translated","value":"Pótlóbusz"}},"it":{"stringUnit":{"state":"translated","value":"Bus sostitutivo"}},"nl":{"stringUnit":{"state":"translated","value":"Vervangende bus"}},"pl":{"stringUnit":{"state":"translated","value":"Komunikacja zastępcza"}},"pt-PT":{"stringUnit":{"state":"translated","value":"Autocarro de substituição"}},"ro":{"stringUnit":{"state":"translated","value":"Autobuz de înlocuire"}},"sv":{"stringUnit":{"state":"translated","value":"Ersättningsbuss"}},"tr":{"stringUnit":{"state":"translated","value":"Ray yerine otobüs"}},"uk":{"stringUnit":{"state":"translated","value":"Автобус замість поїзда"}}}},"Read on your iPhone. Check every detail before you save.":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Přečteno v iPhonu. Před uložením zkontroluj všechny údaje."}},"de":{"stringUnit":{"state":"translated","value":"Auf deinem iPhone gelesen. Prüf alle Angaben, bevor du speicherst."}},"el":{"stringUnit":{"state":"translated","value":"Διαβάστηκε στο iPhone σου. Έλεγξε κάθε στοιχείο πριν την αποθήκευση."}},"en":{"stringUnit":{"state":"translated","value":"Read on your iPhone. Check every detail before you save."}},"es":{"stringUnit":{"state":"translated","value":"Leído en tu iPhone. Revisa cada dato antes de guardar."}},"fr":{"stringUnit":{"state":"translated","value":"Lu sur ton iPhone. Vérifie chaque détail avant d’enregistrer."}},"hu":{"stringUnit":{"state":"translated","value":"Az iPhone-odon olvasva. Mentés előtt ellenőrizz minden adatot."}},"it":{"stringUnit":{"state":"translated","value":"Letto sul tuo iPhone. Controlla ogni dato prima di salvare."}},"nl":{"stringUnit":{"state":"translated","value":"Gelezen op je iPhone. Controleer alle gegevens voordat je bewaart."}},"pl":{"stringUnit":{"state":"translated","value":"Odczytano na iPhonie. Sprawdź wszystkie dane przed zapisaniem."}},"pt-PT":{"stringUnit":{"state":"translated","value":"Lido no teu iPhone. Verifica cada dado antes de guardar."}},"ro":{"stringUnit":{"state":"translated","value":"Citit pe iPhone. Verifică fiecare detaliu înainte să salvezi."}},"sv":{"stringUnit":{"state":"translated","value":"Läst på din iPhone. Kontrollera alla uppgifter innan du sparar."}},"tr":{"stringUnit":{"state":"translated","value":"iPhone’unda okundu. Kaydetmeden önce her bilgiyi kontrol et."}},"uk":{"stringUnit":{"state":"translated","value":"Прочитано на твоєму iPhone. Перевір усі дані перед збереженням."}}}},"Reading ticket…":{"extractionState":"manual","localizations":{"cs":{"stringUnit":{"state":"translated","value":"Čtení jízdenky…"}},"de":{"stringUnit":{"state":"translated","value":"Ticket wird gelesen …"}},"el":{"stringUnit":{"state":"translated","value":"Ανάγνωση εισιτηρίου…"}},"en":{"stringUnit":{"state":"translated","value":"Reading ticket…"}},"es":{"stringUnit":{"state":"translated","value":"Leyendo el billete…"}},"fr":{"stringUnit":{"state":"translated","value":"Lecture du billet…"}},"hu":{"stringUnit":{"state":"translated","value":"Jegy beolvasása…"}},"it":{"stringUnit":{"state":"translated","value":"Lettura del biglietto…"}},"nl":{"stringUnit":{"state":"translated","value":"Ticket wordt gelezen…"}},"pl":{"stringUnit":{"state":"translated","value":"Odczytywanie biletu…"}},"pt-PT":{"stringUnit":{"state":"translated","value":"A ler o bilhete…"}},"ro":{"stringUnit":{"state":"translated","value":"Se citește biletul…"}},"sv":{"stringUnit":{"state":"translated","value":"Läser biljetten …"}},"tr":{"stringUnit":{"state":"translated","value":"Bilet okunuyor…"}},"uk":{"stringUnit":{"state":"translated","value":"Читання квитка…"}}}},"Recently searched":{"extractionState":"manual",